                    </div>
                </div>
                <div class="container2">
                    <div>
                        <div class="button-group mb-1">
                            <div>
                                <button id="saveClick" class="mui-button mui-button-new" onclick="EditReservation();"><i class="fa-solid fa-floppy-disk"></i></i> Save</button>
