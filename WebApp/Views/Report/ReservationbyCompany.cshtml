@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var rclList = ViewBag.RoomClassList;
    var rtList = ViewBag.RoomTypeList;
}


<style>
    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection {
        background-color: #01579b !important; /* màu xanh ngọc */
        color: white !important; /* chữ trắng */
    }

        #gridContainer .dx-datagrid-rowsview .dx-selection * {
            color: white !important;
        }

</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <!-- From Date -->
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">From Date:</label>
            <input type="date" id="fromDate" name="fromDate" class="form-control form-control-sm w-auto" />
        </div>

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">To Date:</label>
            <input type="date" id="toDate" name="toDate" class="form-control form-control-sm w-auto" />
        </div>

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Room Class:</label>
            <select id="roomClass" name="roomClass" class="form-control form-control-sm w-auto">
                <option value="">ALL</option>
                @foreach (var item in rclList)
                {
                    <option value="@item.Code">@item.Code-@item.Description</option>
                }
            </select>

        </div>

         <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Room Type:</label>
            <select id="roomType" name="roomType" class="form-control form-control-sm w-auto">
                <option value="">ALL</option>
                @foreach (var item in rtList)
                {
                    <option value="@item.Code">@item.Code-@item.Description</option>
                }
            </select>

        </div>
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">No of Room:</label>
            <input id="noOfRoom" name="noOfRoom" class="form-control form-control-sm w-auto"  />
        </div>

        <div class="d-flex flex-column me-3">
          
            <div class="d-flex flex-wrap gap-2">
                <label class="mb-1">Include</label>
                <!-- Row 1 -->
                <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="company" name="includeOptions" value="0" checked>
                    <label class="form-check-label" for="arrival">Company</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="travelAgent" name="includeOptions" value="1">
                    <label class="form-check-label" for="cancel">Travel Agent</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="source" name="includeOptions" value="2">
                    <label class="form-check-label" for="cancel">Source</label>
                </div>
                 <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="group" name="includeOptions" value="3">
                    <label class="form-check-label" for="cancel">Group</label>
                </div>
                 <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="rateCode" name="includeOptions" value="4">
                    <label class="form-check-label" for="cancel">Rate Code</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="resType" name="includeOptions" value="5">
                    <label class="form-check-label" for="cancel">Res. Type</label>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <label class="me-2 mb-0">Sort Order:</label>
            <select id="sortOrder" name="sortOrder" class="form-control form-control-sm w-auto">
                <option value="0">Alphabetical</option>
                <option value="1">Arrival Date</option>
                <option value="2">Market Code</option>
                <option value="3">Room</option>
            </select>
        </div>
    </div>
    <div class=" mb-3 ">
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnPrint" class="mui-button mui-button-new"><i class="fa-solid fa-eye"></i>View</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportExcel" class="mui-button mui-button-new" type="button"> <i class="fa-solid fa-file-excel"></i> Excel</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportPdf" class="mui-button mui-button-new" type="button"><i class="fas fa-eraser"></i> PDF</button>
    </div>
</div>

<div class="mui-card">
@*     <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridContainer" class="mt-2"></div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>

    function formatDate(date) {
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        let day = date.getDate().toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        return `${year}-${month}-${day}`;
    }

    $(document).ready(function () {
         document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        const today = new Date();

        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        // Lấy ngày cuối cùng của tháng
        const lastDayOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        // Định dạng theo local time
        const formattedFirstDay = formatDate(firstDayOfMonth);
        const formattedLastDay = formatDate(lastDayOfMonth);

        console.log(formattedFirstDay); // Kiểm tra giá trị đúng chưa
        console.log(formattedLastDay); // Kiểm tra giá trị đúng chưa
        // Gán giá trị cho input date
        document.getElementById('fromDate').value = formattedFirstDay;
        document.getElementById('toDate').value = formattedLastDay;



    });
    $(".include-option").on("change", function () {
        $(".include-option").not(this).prop("checked", false);
    });
    $("#btnPrint").click(function () {
        $("#loadingSpinner").show();
         var typeDate = $(".include-option:checked").val();
        $.ajax({
            url: '/Report/ReservationbyCompanyReport',
            type: 'GET',
            data: {
                fromDate: $("#fromDate").val(),
                     toDate: $("#toDate").val(),
                        roomClass: $("#roomClass").val(),
                     roomType: $("#roomType").val(),
                    searchCrip: typeDate,
                     sortOrder: $("#sortOrder").val(),
                      noOfRoom: $("#noOfRoom").val(),
            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
                  const processedData = prepareReservationByCompanyData(result);
           initializeReservationbyCompanyGrid(processedData);

                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });
          function prepareReservationByCompanyData(data) {
        const groupedData = {};
        const selectedOptions = [];

        // Lấy các checkbox được chọn
        $(".include-option:checked").each(function() {
            selectedOptions.push($(this).val());
        });

        // Group dữ liệu theo các checkbox được chọn
        data.forEach(item => {
            let key = null;

            if (selectedOptions.includes("0") && item.company) {
                key = item.company;
            } else if (selectedOptions.includes("1") && item.agent) {
                key = item.agent;
            } else if (selectedOptions.includes("2") && item.source) {
                key = item.source;
            } else if (selectedOptions.includes("3") && item.group) {
                key = item.group;
            }  
            else if (selectedOptions.includes("4") && item.group) {
                key = item.rateCode;
            }
            else if (selectedOptions.includes("5") && item.group) {
                key = item.reservationTypeCode;
            }

            if (key) {
                if (!groupedData[key]) groupedData[key] = [];
                groupedData[key].push(item);
            }
        });

        const finalData = [];

        Object.entries(groupedData).forEach(([groupKey, records]) => {
            finalData.push(...records);

            const totalRow = {
                company: "TOTAL",  // Đặt tên hiển thị
        agent: "",
        source: "",
        group: groupKey,  // Hiển thị tên nhóm (nếu có)
        // Tính tổng cho các trường cần thiết
        noOfAdult: sum(records, 'noOfAdult'),
        noOfChild: sum(records, 'noOfChild'),
        noOfChild1: sum(records, 'noOfChild1'),
        noOfRoom: sum(records, 'noOfRoom'),
        noOfNight: sum(records, 'noOfNight'),
        isTotal: true // Cờ dòng tổng
            };

            finalData.push(totalRow);
        });

        return finalData;
    }

     function sum(arr, field) {
        return arr.reduce((total, item) => total + (item[field] || 0), 0);
    }

   

    function initializeReservationbyCompanyGrid(data) {
        const columnWidth = 180;
        $("#gridContainer").dxDataGrid({
            dataSource: data,
            columns: [
               { dataField: "roomNo", caption: "RoomNo", width: columnWidth -70},

            { dataField: "account", caption: "Name", width: columnWidth },
            {
                  caption: "Company/Travel Agent/Source",
                 width: columnWidth+90,
                  dataType: "string",
                  calculateCellValue: function (data) {
                        return data.company || data.agent || data.source || "";
                  }
            },

            { dataField: "arrivalDate", caption: "Arr.Date", width: columnWidth-70, dataType: "date", format: "dd/MM/yyyy" },
            { dataField: "departureDate", caption: "Dep.Date", width: columnWidth-70 , dataType: "date", format: "dd/MM/yyyy" },

            { dataField: "noOfAdult", caption: "Adl", width:  columnWidth-100, dataType: "number", format: "#,##0" },
             { dataField: "noOfChild", caption: "Chi", width: columnWidth-100, dataType: "number", format: "#,##0" },
            { dataField: "noOfChild1", caption: "Chi1", width: columnWidth-100, dataType: "number", format: "#,##0" },
            { dataField: "noOfRoom", caption: "Rms", width:  columnWidth-100, dataType: "number", format: "#,##0" },
             { dataField: "noOfNight", caption: "Nst", width:  columnWidth-100, dataType: "number", format: "#,##0" },

              { dataField: "reservationTypeCode", caption: "Res.Type", width:  columnWidth-30 },
             { dataField: "roomType", caption: "Room Type", width: columnWidth-60 },
            { dataField: "marketCode", caption: "Mct.Code", width: columnWidth-60},
                        { dataField: "", caption: "C/H", width: columnWidth-60},
            { dataField: "sourceCode", caption: "Src.Code", width:  columnWidth-50 },
             { dataField: "loginName", caption: "User", width:  columnWidth-70 },

               { dataField: "createDate", caption: "Made On", width:  columnWidth-70, dataType: "date", format: "dd/MM/yyyy" },
             { dataField: "rateCode", caption: "Rate Code", width: columnWidth-70},
            { dataField: "rate", caption: "Rate Amt.", width: columnWidth-60, dataType: "number", format: "#,##0" },
            { dataField: "packages", caption: "Packages", width:  columnWidth-70 },
             { dataField: "currencyID", caption: "Crr.", width:  columnWidth-90 }
            ],
            paging: { pageSize: 25 },
             scrolling:  {
                   mode: 'virtual',
               useNative: true,
               showScrollbar: "always"
               },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },
            
             filterRow: {
                 visible: true,
                 applyFilter: "auto"
              },
               headerFilter: {
                  visible: true
              },
            selection: { mode: "multiple", showCheckBoxesMode: "none" },
            showBorders: true

        });
    }



    $("#btnExportExcel").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");
        var selectedReport='@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet("Sheet 1");

        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            // Đặt tên file theo selectedReport
            let fileName =selectedReport + ".xlsx";

            // Ghi file
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
       $("#btnExportPdf").click(function () {
        const { jsPDF } = window.jspdf; // 👈 Bổ sung dòng này

        const doc = new jsPDF();

        DevExpress.pdfExporter.exportDataGrid({
            jsPDFDocument: doc,
            component: $("#gridContainer").dxDataGrid("instance"),
            autoTableOptions: {
                styles: { cellPadding: 2, fontSize: 8 },
                margin: { top: 20 }
            }
        }).then(() => {
            doc.save("BaoCao.pdf");
        });
    });
</script>