<div class="report-bar">
    <h4 id="reportTitle">Product Activity</h4>

    <div class="action-buttons">
        <button class="mui-button mui-button-new" style="background:#3b9ac6;border-radius:4px;margin-right:6px" id="btnPrint">
            <i class="fa-solid fa-eye"></i> View
        </button>
        <button class="mui-button mui-button-new" style="background:green;border-radius:4px;margin-right:6px" id="btnExportExcel">
            <i class="fa-solid fa-file-excel"></i> Excel
        </button>
        <button class="mui-button mui-button-new" style="background:darkorange;border-radius:4px" id="btnExportPdf">
            <i class="fas fa-eraser"></i> PDF
        </button>
    </div>
</div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <label class="fw-bold me-2 mb-0">Date:</label>
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">From Date:</label>
            <input type="date" id="fromDate" name="fromDate" class="form-control form-control-sm w-auto" />
        </div>

        <!-- To Date --> 
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">To Date:</label>
            <input type="date" id="toDate" name="toDate" class="form-control form-control-sm w-auto" />
        </div>

        <label class="fw-bold me-2 mb-0">Filter:</label>
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Zone:</label>
            <select id="zone" name="zone" class="form-control form-control-sm" style="width :100px">
                @foreach (var item in zoneList)
                {
                    <option value="@item.Code">@item.Code</option>
                }
            </select>

        </div>
    </div>
    
</div>

