@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var roomclassList = ViewBag.RoomClassList;
    var rtList = ViewBag.RoomTypeList;
}


<style>
    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection {
        background-color: #01579b !important; /* màu xanh ngọc */
        color: white !important; /* chữ trắng */
    }

        #gridContainer .dx-datagrid-rowsview .dx-selection * {
            color: white !important;
        }

</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Room Class:</label>
            <select id="roomClass" name="roomClass" class="form-control form-control-sm " style="width :100px">
                <option value="">ALL</option>
                @foreach (var item in roomclassList)
                {
                    <option value="@item.ID">@item.Code</option>
                }
            </select>
        </div>

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Room Type:</label>
            <select id="roomtype" name="roomtype" class="form-control form-control-sm " style="width :100px">
                <option value="">ALL</option>
                @foreach (var item in rtList)
                {
                    <option value="@item.ID">@item.Code</option>
                }
            </select>

        </div>

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">From Room</label>
            <input style="width: 130px;" type="text" id="fromRoom" name="fromRoom" class="form-control form-control-sm w-auto" />
        </div>
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">To Room</label>
            <input style="width: 130px;" type="text" id="toRoom" name="toRoom" class="form-control form-control-sm w-auto" />
        </div>
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">HKP Status:</label>
            <select id="hkpStatus" name="hkpStatus" class="form-control form-control-sm w-auto">
                <option value="0">All</option>
                <option value="1">Clean</option>
                <option value="2">Dirty</option>
                <option value="3">Pickup</option>
                <option value="4">Inspected</option>
            </select>
        </div>
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Sort Order:</label>
            <select id="sortOrder" name="sortOrder" class="form-control form-control-sm w-auto">
                <option value="roomnoby">By Room No</option>
                <option value="hkpstatusby">By HKP Status</option>
                <option value="fostatusby">By FOStatus</option>
            </select>
        </div>

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">FO Status:</label>
            <select id="foStatus" name="foStatus" class="form-control form-control-sm w-auto">
                <option value="9">ALL</option>
                <option value="4">Vacant</option>
                <option value="1">Occupied</option>
            </select>
        </div>
        <div class="d-flex flex-column">

            <div class="d-flex flex-wrap gap-2">
                <!-- Row 1 -->
                <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="arrival" name="includeOptions" value="1" >
                    <label class="form-check-label" for="arrival">Group By Room Class</label>
                </div>
            </div>
        </div>

    </div>
    <div class=" mb-3 ">
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnPrint" class="mui-button mui-button-new"><i class="fa-solid fa-eye"></i>View</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportExcel" class="mui-button mui-button-new" type="button"> <i class="fa-solid fa-file-excel"></i> Excel</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportPdf" class="mui-button mui-button-new" type="button"><i class="fas fa-eraser"></i> PDF</button>
    </div>
</div>

<div class="mui-card">
    @*     <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridContainer" class="mt-2"></div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function formatDate(date) {
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        let day = date.getDate().toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        return `${year}-${month}-${day}`;
    }

    $(document).ready(function () {

         document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        const today = new Date();

        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        // Lấy ngày cuối cùng của tháng
        const lastDayOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        // Định dạng theo local time
        const formattedFirstDay = formatDate(firstDayOfMonth);
        const formattedLastDay = formatDate(lastDayOfMonth);

        console.log(formattedFirstDay); // Kiểm tra giá trị đúng chưa
        console.log(formattedLastDay); // Kiểm tra giá trị đúng chưa
        // Gán giá trị cho input date
        document.getElementById('fromDate').value = formattedFirstDay;
        document.getElementById('toDate').value = formattedLastDay;



    });
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
            const orderBy = $("#sortOrder").val(); // dùng chung id nên cần đổi lại nếu có 3 dropdown trùng id

    // Xác định thứ tự sắp xếp
    let orderByRoomNo = 0, orderByHKPStatus = 0, orderByFOStatus = 0;
    if (orderBy === "roomnoby") orderByRoomNo = 1;
    if (orderBy === "hkpstatusby") orderByHKPStatus = 1;
    if (orderBy === "fostatusby") orderByFOStatus = 1;
        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/VacantRoomData',
            type: 'GET',
            data: {
                  roomClass: $("#roomClass").val(),
                   roomtype: $("#roomtype").val(),
                     FromRoom: $("#fromRoom").val(),
                    ToRoom: $("#toRoom").val(),
                    OrderByRoomNo: orderByRoomNo,
                    OrderByHKPStatus: orderByHKPStatus,
                    OrderByFOStatus: orderByFOStatus,
                    HKPStatus: $("#hkpStatus").val(), // bạn cần thêm id="hkpStatus" cho select HKP Status
                    FOStatus: $("#foStatus").val(),   // bạn cần thêm id="foStatus" cho select FO Status
                    IsGroupByRoomClass: $("#arrival").is(":checked") ? 1 : 0
            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
                initializVacantRoomGrid(result);
                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });



    function initializVacantRoomGrid(data) {
        const columnWidth = 180;
        $("#gridContainer").dxDataGrid({
    dataSource: data, allowColumnResizing: true,
            allowColumnResizing: true,
          columnResizingMode: "widget",
            columns: [
               { dataField: "roomNo", caption: "Room Number", width: columnWidth-50},
            { dataField: "code", caption: "Room Type", width: columnWidth-60},
                        { dataField: "foStatus", caption: "FOStatus", width: columnWidth-60 },
                         { dataField: "status", caption: "Status", width: columnWidth-60 },
                                 { dataField: "name", caption: "Name", width: columnWidth-60 },
            { dataField: "arrDate", caption: "Arr.Date", width: columnWidth-60,  dataType: "date", format: "dd/MM/yyyy"},
            { dataField: "depDate", caption: "Dep.Date",width: columnWidth-60,  dataType: "date", format: "dd/MM/yyyy"},
               { dataField: "resvStatus", caption: "Resv.Status", width: columnWidth-50 },


            { dataField: "adl", caption: "Adlts",width: columnWidth-80 ,dataType: "number", format: "#,##0" },
            { dataField: "chld", caption: "Chld", width: columnWidth-80 ,dataType: "number", format: "#,##0" },

             { dataField: "nextBlock", caption: "NextBlock", width: columnWidth-50},
            ],
            paging: { pageSize: 25 },
      scrolling:  {
         
        useNative: true,
       showScrollbar: "always"
    },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },
            selection: { mode: "multiple", showCheckBoxesMode: "none" },
                filterRow: {
         visible: true,
        applyFilter: "auto"
    },
    headerFilter: {
        visible: true
        },summary: {
        totalItems: [
             {column: "resvStatus", summaryType: "custom",displayFormat: "Grand Total"},

            {
                column: "adl",
                summaryType: "sum",
                displayFormat: "{0}",
                valueFormat: "#,##0"
            },
            {
                column: "chld",
                summaryType: "sum",
                displayFormat: "{0}",
                valueFormat: "#,##0"
            }
        ]
    },

            showBorders: true,
                            onRowPrepared: function (e) {
        if (e.rowType === "data" && e.data?.cssClass) {
            e.rowElement.addClass(e.data.cssClass);
        }
    }

        });
    }




    $("#btnExportExcel").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
        worksheet.addRow(['Công ty Cổ phần Giải pháp Công nghệ CS-Solution']);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;
            worksheet.getCell(`A${lastRow}`).value = "--- END  ---";
            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
       $("#btnExportPdf").click(function () {
        const { jsPDF } = window.jspdf; // 👈 Bổ sung dòng này

        const doc = new jsPDF();

        DevExpress.pdfExporter.exportDataGrid({
            jsPDFDocument: doc,
            component: $("#gridContainer").dxDataGrid("instance"),
            autoTableOptions: {
                styles: { cellPadding: 2, fontSize: 8 },
                margin: { top: 20 }
            }
        }).then(() => {
            doc.save("BaoCao.pdf");
        });
    });
</script>