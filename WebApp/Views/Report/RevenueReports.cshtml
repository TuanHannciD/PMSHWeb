@using DevExpress.XtraReports.UI
@{
    ViewBag.Title = ViewBag.ReportHeader;

}

<style>
    .filter_wrapper {
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

    .radio_wrapper {
        margin: 8px 0 8px 14px;
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection {
        background-color: #01579b !important;
        color: white !important;
    }

        #gridContainer .dx-datagrid-rowsview .dx-selection * {
            color: white !important;
        }
</style>

<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <div class="d-flex align-items-center">
            <label class="me-2 mb-0">Date:</label>
            <input type="date" id="fromDate" name="fromDate" class="form-control form-control-sm w-auto" max='@DateTime.Now.ToString("yyyy-MM-dd")' />
        </div>
        <div class="radio_wrapper">
            <label class="me-2">Type:</label>
            <label class="me-2"><input type="radio" name="reportType" value="0" checked /> Revenue</label>
            <label class="me-2"><input type="radio" name="reportType" value="1" /> Payment</label>
            <label class="me-2"><input type="radio" name="reportType" value="2" /> NonRevenue</label>
            <label><input type="radio" name="reportType" value="3" /> All</label>
        </div>
    </div>

    <div class="button_wrapper">
        <button id="btnPrint" class="mui-button mui-button-new" style="border-radius: 4px; background-color: #3b9ac6;">
            <i class="fa-solid fa-eye"></i> View
        </button>
        <button id="btnExportExcel" class="mui-button mui-button-new" style="border-radius: 4px; background-color: #3b9ac6;">
            <i class="fa-solid fa-file-excel"></i> Excel
        </button>
        <button id="btnExportPdf" class="mui-button mui-button-new" style="border-radius: 4px; background-color: #3b9ac6;">
            <i class="fas fa-eraser"></i> PDF
        </button>
    </div>
</div>

<div class="mui-card">
    <div id="gridContainer" class="mt-2"></div>
</div>

<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin fa-2x"></i>
</div>


    <script>
        function formatDate(date) {
            let year = date.getFullYear();
            let month = (date.getMonth() + 1).toString().padStart(2, '0');
            let day = date.getDate().toString().padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        $(document).ready(function () {
            const today = new Date();
            const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
            $('#fromDate').val(formatDate(firstDayOfMonth));

            document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';

            $("#btnPrint").click(function () {
                $("#loadingSpinner").show();

                $.ajax({
                    url: '/Report/RevenueReports',
                    type: 'GET',
                    data: {
                        fromDate: $("#fromDate").val(),
                        type: $("input[name='reportType']:checked").val()
                    },
                    success: function (result) {
                        const data = prepareRevenueData(result);
                        initializeGrid(data);
                        $("#loadingSpinner").hide();
                    },
                    error: function () {
                        alert("Không thể tải báo cáo.");
                        $("#loadingSpinner").hide();
                    }
                });
            });

            $("#btnExportPdf").click(function () {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF();

                DevExpress.pdfExporter.exportDataGrid({
                    jsPDFDocument: doc,
                    component: $("#gridContainer").dxDataGrid("instance"),
                    autoTableOptions: {
                        styles: { cellPadding: 2, fontSize: 8 },
                        margin: { top: 20 }
                    }
                }).then(() => {
                    doc.save("RevenueReport.pdf");
                });
            });
        });

        function prepareRevenueData(data) {
            const grouped = {};
            const result = [];

            data.forEach(item => {
                const key = item.subGroupDescription || "Unknown";
                if (!grouped[key]) grouped[key] = [];
                grouped[key].push(item);
            });

            Object.entries(grouped).forEach(([groupName, items]) => {
                const groupHeader = {
                    transactionCode: groupName,
                    transactionName: "",
                    currencyID: "",
                    subGroupDescription: "",
                    amountBeForeTax: "",
                    amountGross: "",
                    amountBeforeTaxM: "",
                    amountGrossM: "",
                    amountBeforeTaxY: "",
                    amountGrossY: "",
                    cssClass: "group-header"
                };
                result.push(groupHeader);
                result.push(...items);

                const subtotalRow = {
                    transactionCode: "",
                    transactionName: "Sub Total:",
                    currencyID: "VND",
                    subGroupDescription: "",
                    amountBeForeTax: sum(items, "amountBeForeTax"),
                    amountGross: sum(items, "amountGross"),
                    amountBeforeTaxM: sum(items, "amountBeforeTaxM"),
                    amountGrossM: sum(items, "amountGrossM"),
                    amountBeforeTaxY: sum(items, "amountBeforeTaxY"),
                    amountGrossY: sum(items, "amountGrossY"),
                    cssClass: "subtotal"
                };
                result.push(subtotalRow);
            });

            const grandTotalRow = {
                transactionCode: "Grand Total:",
                transactionName: "",
                currencyID: "VND",
                subGroupDescription: "",
                amountBeForeTax: sum(data, "amountBeForeTax"),
                amountGross: sum(data, "amountGross"),
                amountBeforeTaxM: sum(data, "amountBeforeTaxM"),
                amountGrossM: sum(data, "amountGrossM"),
                amountBeforeTaxY: sum(data, "amountBeforeTaxY"),
                amountGrossY: sum(data, "amountGrossY"),
                cssClass: "grandtotal"
            };

            result.push(grandTotalRow);
            return result;
        }

        function sum(arr, field) {
            return arr.reduce((total, item) => total + (item[field] || 0), 0);
        }

        function initializeGrid(data) {
            $("#gridContainer").dxDataGrid({
                dataSource: data,
                showBorders: true,
                rowAlternationEnabled: true,
                columns: [
                    { dataField: "transactionCode", caption: "Code", width: 150 },
                    { dataField: "transactionName", caption: "Description", width: 250 },
                    { dataField: "currencyID", caption: "Curr", width: 80 },             
                    { dataField: "amountBeForeTax", caption: "DAY Net", format: "#,##0", width: 160 },
                    { dataField: "amountGross", caption: "DAY Gross", format: "#,##0", width: 160 },
                    { dataField: "amountBeforeTaxM", caption: "MONTH Net", format: "#,##0", width: 160 },
                    { dataField: "amountGrossM", caption: "MONTH Gross", format: "#,##0", width: 160 },
                    { dataField: "amountBeforeTaxY", caption: "YEAR Net", format: "#,##0", width: 160 },
                    { dataField: "amountGrossY", caption: "YEAR Gross", format: "#,##0", width: 160 }
                ],
                onRowPrepared: function (e) {
                    if (e.rowType === "data") {
                        if (e.data?.cssClass === "group-header") {
                            e.rowElement.css({
                                'font-weight': 'bold',
                                'background-color': '#e3f2fd'
                            });
                        } else if (e.data?.cssClass === "subtotal") {
                            e.rowElement.css({
                                'font-weight': 'bold',
                                'background-color': '#f1f8e9'
                            });
                        } else if (e.data?.cssClass === "grandtotal") {
                            e.rowElement.css({
                                'font-weight': 'bold',
                                'background-color': '#ffe0b2'
                            });
                        }
                    }
                },
                paging: { pageSize: 25 },
                pager: {
                    visible: true,
                    allowedPageSizes: [25, 50, 'all'],
                    showPageSizeSelector: true,
                    showInfo: true,
                    showNavigationButtons: true
                },
                filterRow: { visible: true, applyFilter: "auto" },
                headerFilter: { visible: true }
            });
        }
    </script>

