@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var roomClassList = ViewBag.RoomClassList;
    var roomTypeList = ViewBag.RoomTypeList;
}


<style>
    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection {
        background-color: #01579b !important; /* màu xanh ngọc */
        color: white !important; /* chữ trắng */
    }

        #gridContainer .dx-datagrid-rowsview .dx-selection * {
            color: white !important;
        }

    .sticky-header label,
    .sticky-header .form-control-sm {
        font-size: 0.75rem;
        line-height: 1.2;
    }


    .sticky-header .form-control-sm {
        padding: .1rem .35rem;
        height: calc(1.1em + .2rem + 2px);
    }

    .sticky-header label[class*="me-"] {
        margin-right: .5rem !important;
    }

    #gridContainer .dx-datagrid-headers .dx-header-row > td {
        padding: 5px !important;
        height: 24px !important;
        font-size: 12px !important;
        line-height: 1.1 !important;
    }

    #gridContainer .dx-datagrid-rowsview .dx-row > td,
    #gridContainer .dx-datagrid .dx-summary-row > td,
    #gridContainer .dx-datagrid .dx-total-footer td,
    #gridContainer .dx-datagrid .dx-footer-row td {
        font-size: 11px !important;
    }

    .report-bar {
        position: relative;
        margin-bottom: 1rem; /* = mb-3 của bạn */
    }

        /* Tiêu đề ở giữa, full width để text-center hoạt động */
        .report-bar #reportTitle {
            font-size: 20px;
            margin: 0; /* bỏ margin dưới h4/h5 mặc định */
            text-align: center;
        }

        /* Nhóm nút cố định góc phải, canh theo chiều dọc */
        .report-bar .action-buttons {
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
        }

    .tomselect-custom {
        width: 300px;
        min-height: 30px; /* hoặc tùy theo chiều cao bạn muốn */
        font-size: 0.65rem;
    }
        /* Áp dụng font-size nhỏ cho TomSelect dựa vào class gốc .tomselect-custom */
        .tomselect-custom + .ts-wrapper .ts-control,
        .tomselect-custom + .ts-wrapper .ts-dropdown,
        .tomselect-custom + .ts-wrapper .ts-dropdown .option {
            font-size: 0.65rem !important;
            min-height: 30px !important;
        }

</style>
<link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>

<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <!-- From Date -->
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Date:</label>
            <input type="date" id="date" name="date" class="form-control form-control-sm w-auto" />
        </div>


   
            <div class="d-flex align-items-center me-2">
                <label class="me-2 mb-0"></label>
                <input class="form-check-input" type="checkbox" id="isRouting" name="isRouting" checked>
                <label class="form-check-label ms-1" for="isRouting">All Rooms</label>
            
            
            </div>

           
            <div class="d-flex align-items-center ">
                <label class="me-2 mb-0 nowrap-label">Room Class:</label>
                <select id="roomClass" name="roomClass" class="tomselect-custom" style="width :100px" multiple>
                    @foreach (var item in roomClassList)
                    {
                        <option value="@item.Code">@item.Code</option>
                    }
                </select>
            </div>

            <div class="d-flex align-items-center me-3">
                <label class="me-2 mb-0 nowrap-label">Room Type:</label>
                <select id="roomTypeId" name="roomTypeId" class="tomselect-custom" style="width :100px" multiple>
                    @foreach (var item in roomTypeList)
                    {
                        <option value="@item.ID">@item.Code</option>
                    }
                </select>
            </div>
        <div style="display:none">
            <label class="me-2 mb-0">Sort Order</label>
            <input type="text" class="input-text" placeholder="Folio No" />
        </div>

        <div class="d-flex align-items-center me-2">
            <label class="me-2 mb-0">Include:</label>
            <input class="form-check-input" type="checkbox" id="isCheckOut" name="isCheckOut" checked>
            <label class="form-check-label ms-1" for="isCheckOut">Checked Out</label>
        </div>

        </div>
       

    </div>

    <div class=" mb-3 ">
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnPrint" class="mui-button mui-button-new"><i class="fa-solid fa-eye"></i>View</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: green;" id="btnExportExcel" class="mui-button mui-button-new" type="button"> <i class="fa-solid fa-file-excel"></i> Excel</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: darkorange;" id="btnExportPdf" class="mui-button mui-button-new" type="button"><i class="fas fa-eraser"></i> PDF</button>
    </div>


<div class="mui-card">
    @*   <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridContainer" class="mt-2"></div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function formatDate(date) {
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        let day = date.getDate().toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        return `${year}-${month}-${day}`;
    }

    $(document).ready(function () {

         document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        const today = new Date();
        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        // Định dạng theo local time
        const formattedFirstDay = formatDate(firstDayOfMonth);
        console.log(formattedFirstDay); // Kiểm tra giá trị đúng chưa
        // Gán giá trị cho input date
        document.getElementById('date').value = formattedFirstDay;
          initializeTomSelects();
          
            toggleRoomSelectors(); // ✅ Gọi khi trang vừa load
            $("#isRouting").on("change", toggleRoomSelectors);


    });
            function initializeTomSelects() {
        const selectors = ["#roomClass", "#roomTypeId"];

        for (const id of selectors) {
            const el = document.querySelector(id);
            if (!el) continue;

            // Nếu đã khởi tạo rồi thì destroy
            if (el.tomselect) el.tomselect.destroy();

            const ts = new TomSelect(el, {
                plugins: ['remove_button'],
                create: false,
                maxItems: null,
                allowEmptyOption: true,
                placeholder: '',
                persist: false,
                render: {
                    option: function (data, escape) {
                        return `<div>${escape(data.text)}</div>`;
                    }
                }
            });

        }
    }


    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/GuestTrialBalance',
            type: 'GET',
            data: {
                date: $("#date").val(),
                roomClass: ($("#roomClass").val() || []).join(','),
                roomTypeId: ($("#roomTypeId").val() || []).join(','),
                isCheckOut: $("#isCheckOut").is(":checked") ? 1 : 0,
                isRouting: $("#isRouting").is(":checked") ? 1 : 0

            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
                success: function (result) {
                console.log("Result from server:", result);
                const prepared = prepareReservationData(result);
                initializReveunueByGrid(prepared);     
                $("#loadingSpinner").hide();
            },

                    error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });
        function toggleRoomSelectors() {
        const isAllRooms = $("#isRouting").is(":checked");   // true = ALL
        $("#roomClass").prop("disabled", isAllRooms);        // khóa/mở Room Class
        $("#roomTypeId").prop("disabled", isAllRooms);       // khóa/mở Room Type
        // Nếu dùng TomSelect: cũng disable instance để không bấm được
        for (const id of ["#roomClass", "#roomTypeId"]) {
            const ts = $(id)[0].tomselect;
            if (ts) ts.disable();        // luôn disable trước
            if (!isAllRooms && ts) ts.enable();   // mở lại nếu cần
        }
    }

            function prepareReservationData(data) {
        const grouped = {};
        const result = [];

        // Nhóm dữ liệu theo reservation
        data.forEach(item => {
            const reservation = item.reservation || "Unknown Reservation";
            if (!grouped[reservation]) grouped[reservation] = [];
            grouped[reservation].push(item);
        });

        // Duyệt từng nhóm reservation
        Object.entries(grouped).forEach(([reservation, items]) => {
            // Header nhóm reservation
            result.push({
                isGroupHeader: true,
                folioID: reservation,
                cssClass: "bold group-header"
            });

            // Dòng dữ liệu chi tiết
            result.push(...items.map(x => ({
                ...x,
                isGroupHeader: false,
                isSubtotal: false,
                isGrandTotal: false
            })));

            // Tính subtotal
            result.push({
                isSubtotal: true,
                departureDate:"Total",
                debit: sum(items, "debit"),
                credit: sum(items, "credit"),
                openBalance: sum(items, "openBalance"),
                closeBalance: sum(items, "closeBalance"),
                debitTranfer: sum(items, "debitTranfer"),
                creditTranfer: sum(items, "creditTranfer"),
                currency:"VND",
                cssClass: "bold group-total"
            });
        });

        // Grand Total
        result.push({
            isGrandTotal: true,          
            departureDate:"Grand Total",
            debit: sum(data, "debit"),
            credit: sum(data, "credit"),
            openBalance: sum(data, "openBalance"),
            closeBalance: sum(data, "closeBalance"),
            debitTranfer: sum(data, "debitTranfer"),
            creditTranfer: sum(data, "creditTranfer"),
            currency:"VND",
            cssClass: "bold grandtotal"
        });

        return result;
    }

    function sum(arr, field) {
        return arr.reduce((total, item) => total + (item[field] || 0), 0);
    }



    function initializReveunueByGrid(data) {
        const columnWidth = 180;
        $("#gridContainer").dxDataGrid({
        dataSource: data, allowColumnResizing: true,
            columns: [

            { dataField: "folioID", caption: "Folio", width: columnWidth-50 },
            { dataField: "room", caption: "Ro.", width: columnWidth-70 },
            { dataField: "accountName", caption: "Name", width:columnWidth+90},
            { dataField: "arrivalDate", caption: "Arr.", width: columnWidth-50 },
            { dataField: "departureDate", caption: "Dep.", width: columnWidth-50 },
            { dataField: "openBalance", caption: "Open Balance", width: columnWidth-50, dataType: "number", format: "#,##0"},
            { dataField: "debit", caption: "Debit", width:columnWidth-50, dataType: "number", format: "#,##0" },
            { dataField: "debitTranfer", caption: "DebitTranfer", width: columnWidth-50, dataType: "number", format: "#,##0"},
            { dataField: "credit", caption: "Credit", width: columnWidth-50, dataType: "number", format: "#,##0" },
            { dataField: "creditTranfer", caption: "CreditTranfer", width: columnWidth-50, dataType: "number", format: "#,##0" },
            { dataField: "closeBalance", caption: "Close Balance", width: columnWidth-50, dataType: "number", format: "#,##0"},
            { dataField: "currency", caption: "Curr.", width: columnWidth-70},
            { dataField: "status", caption: "Rsv. Status", width: columnWidth-50},
            ],
        paging: { pageSize: 25 },
    //     scrolling:  {
    //     mode: 'virtual',
    //     useNative: true,
    //     showScrollbar: "always"
    // },
        pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
        },
        selection: { mode: "multiple", showCheckBoxesMode: "none" },
        filterRow: {
        visible: true,
        applyFilter: "auto"
    },
         headerFilter: {
        visible: true
    },
            showBorders: true,
            onRowPrepared: function (e) {
        if (e.rowType === "data" && e.data && e.data.cssClass) {
            $(e.rowElement).addClass(e.data.cssClass);
        }
    }

        });
    }



    $("#btnExportExcel").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");
        var selectedReport='@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet("Sheet 1");

        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            // Đặt tên file theo selectedReport
            let fileName =selectedReport + ".xlsx";

            // Ghi file
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
       $("#btnExportPdf").click(function () {
        const { jsPDF } = window.jspdf; // 👈 Bổ sung dòng này

        const doc = new jsPDF();

        DevExpress.pdfExporter.exportDataGrid({
            jsPDFDocument: doc,
            component: $("#gridContainer").dxDataGrid("instance"),
            autoTableOptions: {
                styles: { cellPadding: 2, fontSize: 8 },
                margin: { top: 20 }
            }
        }).then(() => {
            doc.save("BaoCao.pdf");
        });
    });
</script>