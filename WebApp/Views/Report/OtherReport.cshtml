            <li class="list-group-item"><a style="color:red" class="text-decoration-none report-link" data-report="IncurringDepositReturn" data-title="Incurring Deposit Return">Incurring Deposit Return</a></li>
            <li class="list-group-item"><a style="color:red" class="text-decoration-none report-link" data-report="IncurringDepositSummary" data-title="Incurring Deposit Summary">Incurring Deposit Summary</a></li>
            <li class="list-group-item"><a style="color:red" class="text-decoration-none report-link" data-report="RoomStatistics" data-title="Room Statistics">Room Statistics</a></li>
            <li class="list-group-item"><a style="color:red" class="text-decoration-none report-link" data-report="DailyRevenueReports" data-title="Daily Revenue Reports">Daily Revenue Reports</a></li>
            <li class="list-group-item"><a style="color:red" class="text-decoration-none report-link" data-report="DailyRevenueReportsNew" data-title="Daily Revenue Reports New">Daily Revenue Reports New</a></li>
            <li class="list-group-item"><a style="color:red" class="text-decoration-none report-link" data-report="DailyRevenueReportsV2" data-title="Daily Revenue Reports (V2)">Daily Revenue Reports (V2)</a></li>
