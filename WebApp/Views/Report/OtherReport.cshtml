    .mui-divider {
        border: none;
        border-top: 1px solid #005f87;
        color: #005f87;
        margin: 16px 0;
        margin-bottom: 0px;
    }

    .content_wrapper {
        margin: 12px;
    }

    .filter-header {
        FONT-SIZE: 20PX;
    }

    .list-group-item {
        padding-top: 2px !important;
        padding-bottom: 2px !important;
    }

    .header2 {
        color: black;
        padding: 10px;
        border-radius: 5px 5px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .header2 a {
            color: white;
            text-decoration: none;
            font-size: 14px;
        }

    .form-group2 {
        margin: 15px 0;
    }

        .form-group2 label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .form-group2 input[type="text"],
