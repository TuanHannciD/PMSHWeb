</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>

    function formatDate(date) {
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        let day = date.getDate().toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        return `${year}-${month}`;
    }

    $(document).ready(function () {
    $("#reportTitle").text('@ViewBag.ReportTitle');
        const today = new Date();

        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        // Lấy ngày cuối cùng của tháng
        const lastDayOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        // Định dạng theo local time
        const formattedFirstDay = formatDate(firstDayOfMonth);
        const formattedLastDay = formatDate(lastDayOfMonth);

        console.log(formattedFirstDay); // Kiểm tra giá trị đúng chưa
        console.log(formattedLastDay); // Kiểm tra giá trị đúng chưa
        // Gán giá trị cho input date
        document.getElementById('fromDate').value = formattedFirstDay;
        document.getElementById('toDate').value = formattedLastDay;



    });

    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/AnnualRoomOccupancyData',
            type: 'GET',
            data: {
                fromDate: $("#fromDate").val(),
                        zone: $("#zone").val(),
            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);

           initializeAnnualRoomOccupancyDataGrid(result);

                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });
        function initializeAnnualRoomOccupancyDataGrid(data) {
        const columnWidth = 180;

        const weekdayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

        const fromDateStr = $("#fromDate").val(); // yyyy-MM-dd
        const fromDate = new Date(fromDateStr);
        const fromYear = fromDate.getFullYear();
        const fromMonth = fromDate.getMonth(); // 0-based

        const columns = [
            { dataField: "day", caption: "Day", width: columnWidth - 100 }
        ];

        // Danh sách ánh xạ: fieldName (1..12) -> actual month (0..11)
        const monthMap = [];
        for (let i = 0; i < 12; i++) {
            let actualMonth = (fromMonth + i) % 12;
            let yearOffset = Math.floor((fromMonth + i) / 12); // để xác định đúng năm
            let actualYear = fromYear + yearOffset;

            monthMap.push({
                fieldName: (i + 1).toString(),
                monthIndex: actualMonth,
                year: actualYear,
                caption: monthNames[actualMonth]
            });
        }

        for (let i = 0; i < monthMap.length; i++) {
            const { fieldName, monthIndex, year, caption } = monthMap[i];

            columns.push({
                dataField: fieldName,
                caption: caption,
                width: columnWidth - 90,
                    encodeHtml: false,
                calculateCellValue: function (rowData) {
                    const day = parseInt(rowData.day);
                    if (!day || isNaN(day)) return "";

                    const date = new Date(year, monthIndex, day);
                    const weekday = weekdayNames[date.getDay()];
                    const value = rowData[fieldName];

                     if (value === undefined || value === null || value === "") return "";

                return `<div style="display: flex; justify-content: space-between;">
                            <span>${weekday}</span>
                            <span>${value}</span>
                        </div>`;
                }
            });
        }

        // Xử lý các cột dạng "1_", "2_"...
        const existingFields = new Set(columns.map(c => c.dataField));
        const underscoreFields = new Set();

        data.forEach(item => {
            Object.keys(item).forEach(key => {
                if (/^\d+_$/.test(key) && !existingFields.has(key)) {
                    underscoreFields.add(key);
                }
            });
        });

        for (let fieldName of underscoreFields) {
            columns.push({
                dataField: fieldName,
                caption: fieldName.replace("_", ""),
                width: columnWidth - 80,
                dataType: "number",
                format: "#,##0"
            });
        }

        $("#gridContainer").dxDataGrid({
    dataSource: data, allowColumnResizing: true,
            columns: columns,
            paging: { pageSize: 25 },
            scrolling: {
                mode: 'virtual',
                useNative: true,
                showScrollbar: "always"
            },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true
            },
            filterRow: {
                visible: true,
                applyFilter: "auto"
            },
            headerFilter: {
                visible: true
            },
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "none"
            },
            showBorders: true,
            onRowPrepared: function (e) {
                if (e.rowType === "data" && e.data?.cssClass) {
                    e.rowElement.addClass(e.data.cssClass);
                }
            }
        });
    }



    $("#btnExportExcel").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");
        var selectedReport='@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet("Sheet 1");

        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            // Đặt tên file theo selectedReport
            let fileName =selectedReport + ".xlsx";

            // Ghi file
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
       $("#btnExportPdf").click(function () {
        const { jsPDF } = window.jspdf; // 👈 Bổ sung dòng này

        const doc = new jsPDF();

        DevExpress.pdfExporter.exportDataGrid({
            jsPDFDocument: doc,
            component: $("#gridContainer").dxDataGrid("instance"),
            autoTableOptions: {
                styles: { cellPadding: 2, fontSize: 8 },
                margin: { top: 20 }
            }
        }).then(() => {
            doc.save("BaoCao.pdf");
        });
    });
</script>