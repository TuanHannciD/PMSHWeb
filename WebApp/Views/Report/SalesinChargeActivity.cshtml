    <div class=" mb-3 ">
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnPrint" class="mui-button mui-button-new"><i class="fa-solid fa-eye"></i>View</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportExcel" class="mui-button mui-button-new" type="button"> <i class="fa-solid fa-file-excel"></i> Excel</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportPdf" class="mui-button mui-button-new" type="button"><i class="fas fa-eraser"></i> PDF</button>
    </div>
</div>

<div class="mui-card">
    <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div>
    <div id="gridContainer" class="mt-2"></div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function formatDate(date) {
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        let day = date.getDate().toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        return `${year}-${month}-${day}`;
    }

    $(document).ready(function () {
         document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        const today = new Date();

        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        // Lấy ngày cuối cùng của tháng
        const lastDayOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        // Định dạng theo local time
        const formattedFirstDay = formatDate(firstDayOfMonth);
        const formattedLastDay = formatDate(lastDayOfMonth);

        console.log(formattedFirstDay); // Kiểm tra giá trị đúng chưa
        console.log(formattedLastDay); // Kiểm tra giá trị đúng chưa
        // Gán giá trị cho input date
        document.getElementById('fromDate').value = formattedFirstDay;
        document.getElementById('toDate').value = formattedLastDay;



    });

    $("#btnPrint").click(function () {

            var statusValues = $("input[name='includeOptions']:checked")
        .map(function () {
            return $(this).val();
        }).get().join(',');

        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/SalesinChargeActivityData',
            type: 'GET',
            data: {
                fromDate: $("#fromDate").val(),
                toDate: $("#toDate").val(),
                   type: statusValues,
                   currency: $("#viewBy").val(),
            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
                                      const processedData = preparSalesinChargeActivityData(result);
                initializProductActivityGrid(processedData);
                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });
            function preparSalesinChargeActivityData(data) {
        const groupedData = {};

        // Nhóm dữ liệu theo saleInCharge
        data.forEach(item => {
            const key = item.saleInCharge;
            if (!groupedData[key]) groupedData[key] = [];
            groupedData[key].push(item);
        });

        const finalData = [];

        Object.entries(groupedData).forEach(([saleInCharge, records]) => {
            // Thêm dòng tiêu đề cho mỗi saleInCharge
            const titleRow = {
                guestNo: `S.In Charge: ${saleInCharge}`,
                isTitle: true,
                cssClass: "custom",
            };
            finalData.push(titleRow);

            // Thêm các record
            finalData.push(...records);

            // Thêm dòng TOTAL cho nhóm
            const totalRow = {
                guestNo: "TOTAL",
                totalTurnover: sum(records, 'totalTurnover'),
                roomSales: sum(records, 'roomSales'),
                taxService: sum(records, 'taxService'),
                totalAdult: sum(records, 'totalAdult'),
                totalChild: sum(records, 'totalChild'),
                totalChild1: sum(records, 'totalChild1'),
                totalChild2: sum(records, 'totalChild2'),
                bedNightAC: sum(records, 'bedNightAC'),
                bedNightAll: sum(records, 'bedNightAll'),
                roomNight: sum(records, 'roomNight'),
                total: sum(records, 'total'),
                isTotal: true
            };

            finalData.push(totalRow);
        });

        return finalData;
    }


     function sum(arr, field) {
        return arr.reduce((total, item) => total + (item[field] || 0), 0);
    }

    function average(arr, field) {
        const valid = arr.filter(x => x[field] != null);
        if (valid.length === 0) return 0;
        return valid.reduce((sum, x) => sum + x[field], 0) / valid.length;
    }
    function initializProductActivityGrid(data) {
        const columnWidth = 180;
        $("#gridContainer").dxDataGrid({
            dataSource: data,
            columns: [
               { dataField: "guestNo", caption: "Acc.No", width: columnWidth-40 },
            { dataField: "guestName", caption: "Account", width: columnWidth },
            { dataField: "city", caption: "City", width: columnWidth-80},
            { dataField: "totalTurnover", caption: "Total Account", width: columnWidth-70, dataType: "number", format: "#,##0" },
            { dataField: "roomSales", caption: "Room Sales", width: columnWidth-70, dataType: "number", format: "#,##0" },,
              { dataField: "taxService", caption: "Tax & SC", width: columnWidth-70, dataType: "number", format: "#,##0" },

               { dataField: "totalAdult", caption: "A", width: columnWidth-100, dataType: "number", format: "#,##0" },
               { dataField: "totalChild", caption: "C", width:columnWidth-100, dataType: "number", format: "#,##0" },
            { dataField: "totalChild1", caption: "C1", width: columnWidth-100 , dataType: "number", format: "#,##0" },
            { dataField: "totalChild2", caption: "C2", width: columnWidth-100, dataType: "number", format: "#,##0" },
              { dataField: "bedNightAC", caption: "BN1", width: columnWidth-100, dataType: "number", format: "#,##0" },

              { dataField: "bedNightAll", caption: "BN2", width:columnWidth-100, dataType: "number", format: "#,##0" },
            { dataField: "roomNight", caption: "RN", width: columnWidth-100 , dataType: "number", format: "#,##0" },
            { dataField: "amountAvg", caption: "Avg", width: columnWidth-70, dataType: "number", format: "#,##0" },
                        { dataField: "currencyID", caption: "Curr.", width: columnWidth-100, dataType: "number", format: "#,##0" },
            ],
            paging: { pageSize: 25 },
      scrolling:  {
         mode: 'virtual',
        useNative: true,
       showScrollbar: "always"
    },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },       summary: {
            totalItems: [
                {
                    column: "guestNo",
                    summaryType: "custom",
                    displayFormat: "Total"
                },
                { column: "totalAdult", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
                { column: "totalChild", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
                { column: "totalChild1", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
                { column: "totalChild2", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
                { column: "bedNightAC", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
                { column: "bedNightAll", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
                { column: "roomNight", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
                { column: "amountAvg", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
            ]
        },
            selection: { mode: "multiple", showCheckBoxesMode: "none" },
                filterRow: {
         visible: true,
        applyFilter: "auto"
    },
    headerFilter: {
        visible: true
    },
            showBorders: true,
                    onRowPrepared: function (e) {
        if (e.rowType === "data" && e.data?.cssClass) {
            e.rowElement.addClass(e.data.cssClass);
        }
    }

        });
    }



    $("#btnExportExcel").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");
        var selectedReport='@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet("Sheet 1");

        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            // Đặt tên file theo selectedReport
            let fileName =selectedReport + ".xlsx";

            // Ghi file
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
       $("#btnExportPdf").click(function () {
        const { jsPDF } = window.jspdf; // 👈 Bổ sung dòng này

        const doc = new jsPDF();

        DevExpress.pdfExporter.exportDataGrid({
            jsPDFDocument: doc,
            component: $("#gridContainer").dxDataGrid("instance"),
            autoTableOptions: {
                styles: { cellPadding: 2, fontSize: 8 },
                margin: { top: 20 }
            }
        }).then(() => {
            doc.save("BaoCao.pdf");
        });
    });
</script>