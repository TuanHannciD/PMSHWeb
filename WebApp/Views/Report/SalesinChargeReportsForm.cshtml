        function preparSalesinChargeReportsForm1Data(data) {
        const groupedData = {};

        // Group by MonthDisplay
        data.forEach(item => {
            const key = item.zone;
            if (!groupedData[key]) groupedData[key] = [];
            groupedData[key].push(item);
        });

        const finalData = [];

        Object.entries(groupedData).forEach(([month, records]) => {
            const titleRow = {
           saleInCharge: `S.In Charge : ${records[0].zone}`,
           isTitle: true ,
    cssClass: "custom"
          };

         finalData.push(titleRow);
            finalData.push(...records);

            const totalRow = {
                saleInCharge: "TOTAL",
                saleInChargeGroup:records[0].zone,
                t1: sum(records, 't1'),
        t2: sum(records, 't2'),
        t3: sum(records, 't3'),
        t4: sum(records, 't4'),
        t5: sum(records, 't5'),
        t6: sum(records, 't6'),
        t7: sum(records, 't7'),
        t8: sum(records, 't8'),
        t9: sum(records, 't9'),
        t10: sum(records, 't10'),
        t11: sum(records, 't11'),
        t12: sum(records, 't12'),

        // Tính tổng q1 - q4
        q1: sum(records, 'q1'),
        q2: sum(records, 'q2'),
        q3: sum(records, 'q3'),
        q4: sum(records, 'q4'),
               total: sum(records, 'total'),
                cssClass: "custom",
                isTotal: true // Để phân biệt dòng tổng
            };

            finalData.push(totalRow);
        });

        return finalData;
    }

    // Helper functions
    function sum(arr, field) {
        return arr.reduce((total, item) => total + (item[field] || 0), 0);
    }

    function average(arr, field) {
        const valid = arr.filter(x => x[field] != null);
        if (valid.length === 0) return 0;
        return valid.reduce((sum, x) => sum + x[field], 0) / valid.length;
    }

