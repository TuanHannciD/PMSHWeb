            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
                         const processedData = preparSalesinChargeReportsForm1Data(result);
                initializSalesinChargeReportsForm1Grid(processedData);
                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
