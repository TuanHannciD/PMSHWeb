@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var rtList = ViewBag.RoomClassList;
}

<link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.1.3/css/dx.light.css" />
<script src="https://cdn3.devexpress.com/jslib/23.1.3/js/jquery.min.js"></script>
<script src="https://cdn3.devexpress.com/jslib/23.1.3/js/jszip.min.js"></script>

<style>
    .filter_wrapper {
        padding: 18px 0 0 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50;
        color: white;
    }

    /* Giảm chiều cao và font trong TagBox */
    .dx-tagbox {
        height: auto !important;
        font-size: 12px !important;
        padding: 2px 6px !important;
        min-height: 30px;
    }

    .dx-tag-content {
        display: flex !important;
        flex-direction: row !important;
        align-items: center;
        justify-content: space-between;
    }

    .dx-tag-remove-button {
        order: 2;
        margin-left: 6px;
        margin-right: 0;
    }

    /* Ẩn hoàn toàn nút "X" (nút clear) trong TagBox */
    .dx-tagbox .dx-clear-button-area,
    .dx-tagbox .dx-clear-button,
    .dx-tagbox .dx-icon-clear {
        display: none !important;
    }

    .dx-tagbox .dx-texteditor-input-container {
        padding-right: 10px !important;
    }

    .dx-dropdowneditor-button {
        width: 20px !important;
        height: 20px !important;
        top: 4px !important;
        right: 4px !important;
    }

    .dx-dropdowneditor-overlay .dx-list {
        font-size: 12px !important;
    }

  
    #gridContainer .dx-datagrid-rowsview .dx-selection td {
        background-color: #01579b !important;
        color: white !important;
    }

    #reservationStatusBox {
        height: 100px;
        font-size: 13px;
    }


</style>

<div class="text-center" id="reportTitle" style="font-size: 20px"></div>

<div class="d-flex flex-wrap align-items-center gap-3 mb-3">

    <div class="d-flex align-items-center me-3">
        <label class="me-2 mb-0 fw-semibold">Stay Date:</label>
        <input type="date" id="date" name="date" class="form-control form-control-sm w-auto" />
    </div>

    <div class="row mb-3 align-items-center">
        <label class="col-sm-2 col-form-label fw-semibold text-end">Reservation Status:</label>
        <div class="col-sm-6">
            <select multiple class="form-select form-select-sm" id="reservationStatusBox" size="5">
                <option value="0">Reserved</option>
                <option value="1">Checked In</option>
                <option value="2">Checked Out</option>
                <option value="3">Cancel Rsv</option>
                <option value="4">Waitlist</option>
                <option value="5">Due In</option>
                <option value="6">Due Out</option>
                <option value="7">No Show</option>
                <option value="8">Day Use</option>
            </select>
        </div>
    </div>



    

</div>

<div class="d-flex flex-wrap gap-4 mb-3">

    <!-- Include -->
    <div>
        <label class="fw-semibold mb-2 d-block">Include</label>
        <div class="d-flex flex-wrap gap-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ind" checked />
                <label class="form-check-label" for="ind">Individuals</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="pseudo" />
                <label class="form-check-label" for="pseudo">Pseudo Rooms</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="variance" />
                <label class="form-check-label" for="variance">With a Variance Only</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="fixRate" />
                <label class="form-check-label" for="fixRate">Fixed Rate Only</label>
            </div>
        </div>
    </div>
    <div class="w-10"></div>
    <!-- Display -->
    <div>
        <label class="fw-semibold mb-2 d-block">Display</label>
        <div class="d-flex flex-wrap gap-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="package" checked />
                <label class="form-check-label" for="package">Packages</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="fixCharge" />
                <label class="form-check-label" for="fixCharge">Fixed Charges</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="dcReason" />
                <label class="form-check-label" for="dcReason">Discount Reasons</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="alerts" />
                <label class="form-check-label" for="alerts">Alerts</label>
            </div>
        </div>
    </div>
    <div class="w-0"></div>
    <div class="d-flex align-items-center me-3">
        <label class="me-2 mb-0 fw-semibold">Sort:</label>
        <select id="sort" class="form-select form-select-sm w-auto">
            <option value="Room No.">Room No.</option>
            <option value="Name">Name</option>
        </select>
    </div>

</div>


<div class=" mb-3 ">
    <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnPrint" class="mui-button mui-button-new"><i class="fa-solid fa-eye"></i>View</button>
    <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportExcel" class="mui-button mui-button-new" type="button"> <i class="fa-solid fa-file-excel"></i> Excel</button>
    <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportPdf" class="mui-button mui-button-new" type="button"><i class="fas fa-eraser"></i> PDF</button>
</div>


<div class="mui-card">
    @*     <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridContainer" class="mt-2"></div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function formatDate(date) {
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        let day = date.getDate().toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        return `${year}-${month}-${day}`;
    }

       $(document).ready(function () {        
        const today = new Date();
        const formattedToday = formatDate(today);
        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        $('#date').val(formatDate(firstDayOfMonth));
        document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
     
        const dtpInput = document.getElementById('date');
        if (dtpInput) {
            dtpInput.value = formattedToday;
        }
    });

    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        const status = $("#reservationStatusBox").val() || [];
        const requestData = {
                date: $('#date').val(),
                status: status.join(','),
                ind: $('#ind').is(":checked") ? 1 : 0,
                pseudo: $('#pseudo').is(":checked") ? 1 : 0,
                variance: $('#variance').is(":checked") ? 1 : 0,
                fixRate: $('#fixRate').is(":checked") ? 1 : 0,
                package: $('#package').is(":checked") ? 1 : 0,
                fixCharge: $('#fixCharge').is(":checked") ? 1 : 0,
                dcReason: $('#dcReason').is(":checked") ? 1 : 0,
                alerts: $('#alerts').is(":checked") ? 1 : 0,
                sort: $('#sort').val(),
                showFixCharge: $('#fixCharge').is(":checked") ? 1 : 0,
                showAlerts: $('#alerts').is(":checked") ? 1 : 0
            };

        $.ajax({
            url: '/Report/ReservationRateCheck',
            type: 'GET',
            data: requestData,                        
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
                    initializeNoShowReportDataGrid(result);

                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });


    function initializeNoShowReportDataGrid(data) {
        
        $("#gridContainer").dxDataGrid({
    dataSource: data, allowColumnResizing: true,
            columns: [
                         
                { dataField: "confirmationNo", caption: "Conf. No.", width: 110 },
                { dataField: "name", caption: "Name", width: 200},
                { dataField: "arrival", caption: "Arrival", width: 110, dataType: "date", format: "yyyy-MM-dd" },
                { dataField: "departure", caption: "Departure", width: 110, dataType: "date", format: "yyyy-MM-dd" },
                { dataField: "nts", caption: "Nts.", dataType: "number", width: 90 },
                { dataField: "adl", caption: "Adl.", dataType: "number", width: 90 },
                { dataField: "chl", caption: "Chl.", dataType: "number", width: 90 },
                { dataField: "roomType", caption: "Room Type", width: 120 },
                { dataField: "rateCode", caption: "Rate Code", width: 120 },
                { dataField: "rateCodeAmt", caption: "Rate Code Amt.", width: 130, dataType: "number", format: "#,##0.00" },
                { dataField: "rateAmt", caption: "Rate Amt.", width: 130, dataType: "number", format: "#,##0.00" },
                { dataField: "variance", caption: "Variance", width: 130 },
                { dataField: "payMth", caption: "Pay Mth.", width: 130 },
                { dataField: "resvStatus", caption: "Resv. Status", width: 130 },
                { dataField: "fixedRate", caption: "Fixed Rate", width: 120 },
                { dataField: "roomNo", caption: "Room No.", width: 130 },
                { dataField: "holder", caption: "Holder", width: 200,
                        cellTemplate: function (container, options) {
                            container.append($("<div>").text(options.text).css({
                            "white-space": "normal",
                            "word-wrap": "break-word",
                            "line-height": "1.2"
                    }));
                }},                           
                { dataField: "marketCode", caption: "Market Code", width: 130 },
                { dataField: "cur", caption: "Cur.", width: 80 },
                { dataField: "reservationPackages", caption: "Reservation Packages", width: 170 }
            ],

            paging: { pageSize: 25 },
             // scrolling:  {
             //       mode: 'virtual',
             //   useNative: true,
             //   showScrollbar: "always"
             //   },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },
             filterRow: {
                 visible: true,
                 applyFilter: "auto"
              },
               headerFilter: {
                  visible: true
              },
            selection: { mode: "multiple", showCheckBoxesMode: "none" },
            showBorders: true

        });
    }




    $("#btnExportExcel").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
        worksheet.addRow(['Công ty Cổ phần Giải pháp Công nghệ CS-Solution']);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;
            worksheet.getCell(`A${lastRow}`).value = "--- END  ---";
            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
       $("#btnExportPdf").click(function () {
        const { jsPDF } = window.jspdf; // 👈 Bổ sung dòng này

        const doc = new jsPDF();

        DevExpress.pdfExporter.exportDataGrid({
            jsPDFDocument: doc,
            component: $("#gridContainer").dxDataGrid("instance"),
            autoTableOptions: {
                styles: { cellPadding: 2, fontSize: 8 },
                margin: { top: 20 }
            }
        }).then(() => {
            doc.save("BaoCao.pdf");
        });
    });
</script>