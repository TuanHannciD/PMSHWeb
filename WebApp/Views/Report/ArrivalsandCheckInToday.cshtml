@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var roomclassList = ViewBag.RoomClassList;
    var rtList = ViewBag.RoomTypeList;
    var arList = ViewBag.ARPaymentList;
    var vipList = ViewBag.VIPList;
}


<style>
    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection {
        background-color: #01579b !important; /* màu xanh ngọc */
        color: white !important; /* chữ trắng */
    }

        #gridContainer .dx-datagrid-rowsview .dx-selection * {
            color: white !important;
        }

</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">


        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Room Class:</label>
            <select id="roomClass" name="roomClass" class="form-control form-control-sm " style="width :100px">
                <option value="">ALL</option>
                @foreach (var item in roomclassList)
                {
                    <option value="@item.Code">@item.Code</option>
                }
            </select>
        </div>

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Room Type:</label>
            <select id="roomtype" name="roomtype" class="form-control form-control-sm " style="width :100px">
                <option value="">ALL</option>
                @foreach (var item in rtList)
                {
                    <option value="@item.Code">@item.Code</option>
                }
            </select>

        </div>

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Pay Method:</label>
            <select id="paymethod" name="paymethod" class="form-control form-control-sm " style="width: 100px;">
                <option value="">ALL</option>
                @foreach (var item in arList)
                {
                    <option value="@item.TransactionCode">@item.Description</option>
                }
            </select>

        </div>
        <div class="d-flex align-items-center me-3" id="vipContainer" style="display: none;">
            <label class="me-2 mb-0">VIP:</label>
            <select id="vip" name="vip" class="form-control form-control-sm " style="width: 100px;">
                <option value="">ALL</option>
                @foreach (var item in vipList)
                {
                    <option value="@item.Code">@item.Description</option>
                }
            </select>

        </div>
        <div class="d-flex flex-column me-3">

            <div class="d-flex flex-wrap gap-2">
                <label class="mb-1">Include</label>
                <!-- Row 1 -->
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="pseudo" name="includeOptions" value="1">
                    <label class="form-check-label" for="reservation">Pseudo Rooms</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="chkviponly" name="includeOptions" value="1">
                    <label class="form-check-label" for="chkviponly">Vip Only</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="sharenames" name="includeOptions" value="1">
                    <label class="form-check-label" for="checkedIn">Share Names</label>
                </div>

                <!-- Row 2 -->
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="accompanying" name="includeOptions" value="1">
                    <label class="form-check-label" for="cancellation">Accompanying Names</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="disRoomSharer" name="includeOptions" value="1">
                    <label class="form-check-label" for="waitList">Display Room Sharer </label>
                </div>
               
            </div>
        </div>


        <div class="d-flex flex-column me-3">

            <div class="d-flex flex-wrap gap-2">
                <label class="mb-1">Display</label>
                <!-- Row 1 -->
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="printpate" name="includeOptions"  checked>
                    <label class="form-check-label" for="reservation">Print Rate</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="nopost" name="includeOptions"  checked>
                    <label class="form-check-label" for="checkedOut">No Post</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="commnets" name="includeOptions">
                    <label class="form-check-label" for="checkedIn">Comments</label>
                </div>

            </div>
        </div>


        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Sort Order:</label>
            <select id="viewBy" name="viewBy" class="form-control form-control-sm w-auto">

                <option value="0">Alphabetical</option>
                <option value="1">Room No</option>
                <option value="2">Reservation Status</option>
                <option value="3">VIP code</option>
                <option value="4">Departure Time</option>
            </select>
        </div>
    </div>
    <div class=" mb-3 ">
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnPrint" class="mui-button mui-button-new"><i class="fa-solid fa-eye"></i>View</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportExcel" class="mui-button mui-button-new" type="button"> <i class="fa-solid fa-file-excel"></i> Excel</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportPdf" class="mui-button mui-button-new" type="button"><i class="fas fa-eraser"></i> PDF</button>
    </div>
</div>

<div class="mui-card">
    @*     <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridContainer" class="mt-2"></div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function formatDate(date) {
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        let day = date.getDate().toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        return `${year}-${month}-${day}`;
    }

    $(document).ready(function () {
         function toggleVipDropdown() {
            if ($("#chkviponly").is(":checked")) {
                $("#vipContainer").show();
            } else {
                $("#vipContainer").hide();
                $("#vip").val(""); // Reset dropdown nếu bị ẩn
            }
        }

        $("input[name='includeOptions']").change(function () {
            if ($(this).is(":checked")) {
                $(this).val("1");
            } else {
                // Đặt lại value là 0 nếu cần xử lý khi gửi form
                $(this).val("0");
            }
        });

        // Gọi 1 lần khi trang tải để đảm bảo trạng thái đúng
        $("input[name='includeOptions']").each(function () {
            $(this).trigger("change");
        });


        // Khi checkbox thay đổi trạng thái
        $("#chkviponly").change(toggleVipDropdown);

        // Đảm bảo ban đầu luôn ẩn
        toggleVipDropdown();

         document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        const today = new Date();

        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        // Lấy ngày cuối cùng của tháng
        const lastDayOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        // Định dạng theo local time
        const formattedFirstDay = formatDate(firstDayOfMonth);
        const formattedLastDay = formatDate(lastDayOfMonth);

        console.log(formattedFirstDay); // Kiểm tra giá trị đúng chưa
        console.log(formattedLastDay); // Kiểm tra giá trị đúng chưa
        // Gán giá trị cho input date
        document.getElementById('fromDate').value = formattedFirstDay;
        document.getElementById('toDate').value = formattedLastDay;



    });
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/ArrivalsandCheckInTodayData',
            type: 'GET',
            data: {
                  roomClass: $("#roomClass").val(),
                   roomtype: $("#roomtype").val(),
                    paymethod: $("#paymethod").val(),
                   vip: $("#vip").val(),
                          viewBy: $("#viewBy").val(),

                  pseudo: $("#pseudo").is(":checked") ? "1" : "",
                 chkviponly: $("#chkviponly").is(":checked") ? "1" : "",
          
                disRoomSharer: $("#disRoomSharer").is(":checked") ? "1" :0,
                  nopost:$('#nopost').is(':checked') ? "1" : ""
            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
                initializArrivalsandCheckInTodayGrid(result);
                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });
     

   
    function initializArrivalsandCheckInTodayGrid(data) {
        const columnWidth = 180;
        $("#gridContainer").dxDataGrid({
    dataSource: data, allowColumnResizing: true,
            columns: [
               { dataField: "roomNo", caption: "Room No", width: columnWidth-70},
            { dataField: "name", caption: "Name", width: columnWidth},
             { dataField: "roomClassCode", caption: "Room Class",dataType: "number", format: "#,##0"  },
              {
                caption: "Stay On",
                width: columnWidth + 50,
                    cssClass: "wrap-cell",
                cellTemplate: function(container, options) {
                    const itemInventory = options.data.itemInventory;
                    const specials = options.data.specials;
                    const roomClassCode = options.data.roomClassCode ?? "";
                    const comments = options.data.comment;

                    // Kiểm tra trạng thái checkbox
                    const showComments = $("#commnets").is(":checked");

                    // Dòng 1: ItemInventory và Specials
                    let topLineParts = [];
                    if (itemInventory) {
                        topLineParts.push(`<b>ItemInventory:</b> ${itemInventory}`);
                    }
                    if (specials) {
                        topLineParts.push(`<b>Specials:</b> ${specials}`);
                    }
                    const topLine = topLineParts.length > 0 ? `<div>${topLineParts.join(" | ")}</div>` : "";

                    // Dòng 2: RoomClassCode
                    const roomClassLine = `<div>${roomClassCode}</div>`;

                    // Dòng 3: Comments nếu được chọn
                    let commentsLine = "";
                    if (showComments && comments) {
                        commentsLine = `<div><b>Res.Comments:</b> ${comments}</div>`;
                    }

                    // Gắn vào container
                    container.html(`${topLine}${roomClassLine}${commentsLine}`);
                }
            },

            { dataField: "reservationStatus", caption: "Status", width: columnWidth-70},
            { dataField: "vIP", caption: "VIP", width: columnWidth-80 },
            { dataField: "agent", caption: "Reservation Holder", width: columnWidth},
            { dataField: "businessBlockCode", caption: "BlockCode", width: columnWidth-70 },

                               { dataField: "arrivalDate", caption: "Arr.Date", width: columnWidth-60,  dataType: "date", format: "dd/MM/yyyy"},
                                         { dataField: "eta", caption: "ETA", width: columnWidth-70 },
            { dataField: "departureDate", caption: "Dep.Date",width: columnWidth-60,  dataType: "date", format: "dd/MM/yyyy"},
               { dataField: "etd", caption: "ETD", width: columnWidth-70 },

               { dataField: "roomType", caption: "Ro.Type", width:columnWidth-70 },
            { dataField: "noOfAdult", caption: "A.",width: columnWidth-80 ,dataType: "number", format: "#,##0" },
            { dataField: "noOfChild", caption: "C.", width: columnWidth-80 ,dataType: "number", format: "#,##0" },
              { dataField: "noOfChild1", caption: "C1.", width: columnWidth-80 ,dataType: "number", format: "#,##0" },
                { dataField: "noOfChild2", caption: "C2.", width:columnWidth-80  ,dataType: "number", format: "#,##0" },
                       { dataField: "noOfRoom", caption: "Rms", width:columnWidth-80 ,dataType: "number", format: "#,##0" },

                    { dataField: "paymentMethod", caption: "Pay mth", width: columnWidth-70},
               { dataField: "rateCode", caption: "Rate Code", width:columnWidth-70 },
            { dataField: "rate", caption: "Rate Amount",  width:columnWidth-70,dataType: "number", format: "#,##0" },
             { dataField: "currencyID", caption: "Curr.",  width:columnWidth-70 },
        
            ],
            paging: { pageSize: 25 },
      scrolling:  {
         mode: 'virtual',
        useNative: true,
       showScrollbar: "always"
    },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },
            selection: { mode: "multiple", showCheckBoxesMode: "none" },
                summary: {
        totalItems: [
                     { column: "name",summaryType: "custom", displayFormat: "Total Arrived Room" },
            { column: "roomClassCode", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },

            { column: "roomType",summaryType: "custom", displayFormat: "Total" },
            { column: "noOfAdult", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
            { column: "noOfChild", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
            { column: "noOfChild1", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
            { column: "noOfChild2", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
            { column: "noOfRoom", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
        ]
    },
                filterRow: {
         visible: true,
        applyFilter: "auto"
    },
    headerFilter: {
        visible: true
    },
            showBorders: true,
                            onRowPrepared: function (e) {
        if (e.rowType === "data" && e.data?.cssClass) {
            e.rowElement.addClass(e.data.cssClass);
        }
    }

        });
    }



    $("#btnExportExcel").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");
        var selectedReport='@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet("Sheet 1");

        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            // Đặt tên file theo selectedReport
            let fileName =selectedReport + ".xlsx";

            // Ghi file
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
       $("#btnExportPdf").click(function () {
        const { jsPDF } = window.jspdf; // 👈 Bổ sung dòng này

        const doc = new jsPDF();

        DevExpress.pdfExporter.exportDataGrid({
            jsPDFDocument: doc,
            component: $("#gridContainer").dxDataGrid("instance"),
            autoTableOptions: {
                styles: { cellPadding: 2, fontSize: 8 },
                margin: { top: 20 }
            }
        }).then(() => {
            doc.save("BaoCao.pdf");
        });
    });
</script>