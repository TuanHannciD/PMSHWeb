@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var listpmtr = ViewBag.TransactionsList;
    var listroom = ViewBag.RoomList;
    var listaticl = ViewBag.ArticleList;
    var listcsl = ViewBag.CashierUserList;
    var lisstrcl = ViewBag.RoomClassList;
}



<style>
    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection {
        background-color: #01579b !important; /* màu xanh ngọc */
        color: white !important; /* chữ trắng */
    }

        #gridContainer .dx-datagrid-rowsview .dx-selection * {
            color: white !important;
        }

</style>
<div class="text-center" id="reportTitle" style="font-size: 20px">
    @Html.Raw(ViewBag.ReportTitle)
</div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <!-- From Date -->
        <div class="d-flex flex-column ">

            <div class="d-flex align-items-center">
                <label class="fw-bold">Date :</label>
                    <div class="d-flex align-items-center me-3">
                        <label class="me-2 mb-0">From Date:</label>
                        <input type="date" id="fromDate" name="fromDate" class="form-control form-control-sm w-auto" />
                    </div>

                    <div class="d-flex align-items-center me-3">
                        <label class="me-2 mb-0">To Date:</label>
                        <input type="date" id="toDate" name="toDate" class="form-control form-control-sm w-auto" />
                    </div>
            </div>
        </div>

        <div class="d-flex flex-column">

            <!-- Hàng 1 -->
            <div class="d-flex align-items-center mb-2">
                <label class="fw-bold me-3">Filter:</label>

                <div class="d-flex align-items-center me-3">
                    <label class="me-2 mb-0">Room Class:</label>
                    <select id="roomclass" name="roomclass" class="form-control form-control-sm" style="width: 100px;">
                        <option value="">ALL</option>
                        @foreach (var item in lisstrcl)
                        {
                            <option value="@item.Code">@item.Code-@item.Name</option>
                        }
                    </select>
                </div>

                <div class="d-flex align-items-center me-3">
                    <label class="me-2 mb-0">Transaction Code:</label>
                    <select id="transaction" name="transaction" class="form-control form-control-sm" style="width: 100px;">
                        <option value="">ALL</option>
                        @foreach (var item in listpmtr)
                        {
                            <option value="@item.Code">@item.Code</option>
                        }
                    </select>
                </div>

                <div class="d-flex align-items-center me-3">
                    <label class="me-2 mb-0">Article Code:</label>
                    <select id="article" name="article" class="form-control form-control-sm" style="width: 100px;">
                        <option value="">ALL</option>
                        @foreach (var item in listaticl)
                        {
                            <option value="@item.Code">@item.Description</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Hàng 2: Room và Cashier -->
            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center me-3">
                    <label class="me-2 mb-0">Room:</label>
                    <select id="room" name="room" class="form-control form-control-sm" style="width: 100px;">
                        <option value="">ALL</option>
                        @foreach (var item in listroom)
                        {
                            <option value="@item.RoomNo">@item.RoomNo-@item.RoomName</option>
                        }
                    </select>
                </div>

                <div class="d-flex align-items-center me-3">
                    <label class="me-2 mb-0">Cashier:</label>
                    <select id="cashier" name="cashier" class="form-control form-control-sm" style="width: 100px;">
                        <option value="">ALL</option>
                        @foreach (var item in listcsl)
                        {
                            <option value="@item.CashierNo">@item.CashierNo-@item.UserName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="d-flex align-items-center mt-2">
                <label class="fw-bold me-2 mb-0">Sort Order:</label>
                <select class="form-control form-control-sm w-auto" id="viewBy" name="selectType1">
                    <option value=""></option>
                    <option value="ArticleCode">Article Code</option>
                    <option value="RoomNo">Room No</option>
                    <option value="TransactionCode">Transaction Code</option>
                </select>
            </div>

            <div class="d-flex flex-column me-3 mt-2">

                <div class="d-flex flex-wrap gap-2">
                    <label class="mb-1 fw-bold">Revenue</label>
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="net" name="includeOptions" value="NET" checked>
                        <label class="form-check-label" for="net">NET</label>
                    </div>
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="gross" name="includeOptions" value="GROSS">
                        <label class="form-check-label" for="gross">GROSS</label>
                    </div>


                </div>
            </div>
        </div>








    </div>
    <div class=" mb-3 ">
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnPrint" class="mui-button mui-button-new"><i class="fa-solid fa-eye"></i>View</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportExcel" class="mui-button mui-button-new" type="button"> <i class="fa-solid fa-file-excel"></i> Excel</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportPdf" class="mui-button mui-button-new" type="button"><i class="fas fa-eraser"></i> PDF</button>
    </div>
</div>

<div class="mui-card">
    @*     <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridContainer" class="mt-2"></div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function formatDate(date) {
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        let day = date.getDate().toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        return `${year}-${month}-${day}`;
    }


    $(document).ready(function () {
        const decodedTitle = $("<div>").html('@ViewBag.ReportTitle').text();
        document.getElementById("reportTitle").innerText = decodedTitle;

        const today = new Date();

        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        // Lấy ngày cuối cùng của tháng
        const lastDayOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        // Định dạng theo local time
        const formattedFirstDay = formatDate(firstDayOfMonth);
        const formattedLastDay = formatDate(lastDayOfMonth);

        console.log(formattedFirstDay); // Kiểm tra giá trị đúng chưa
        console.log(formattedLastDay); // Kiểm tra giá trị đúng chưa
        // Gán giá trị cho input date
        document.getElementById('fromDate').value = formattedFirstDay;
        document.getElementById('toDate').value = formattedLastDay;



    });
        $(document).on("change", "input[name='includeOptions']", function () {
        // Bỏ chọn tất cả
        $("input[name='includeOptions']").not(this).prop("checked", false);
    });

    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();

        const includeOption = $("input[name='includeOptions']:checked").val() || "";

        $.ajax({
            url: '/Report/JournalByCashierArticleData',
            type: 'GET',
            data: {
                fromDate: $("#fromDate").val(),
                toDate: $("#toDate").val(),
                transaction: $("#transaction").val(),
                room: $("#room").val(),
                roomclass: $("#roomclass").val(),
                viewBy: $("#viewBy").val(),
                article: $("#article").val(),
                cashier: $("#cashier").val(),
                netDisp: includeOption
            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
                        const processed = prepareArticleByRoomsData(result);
                        initializeJournalByCashierArticleGrid(processed.data, processed.grandTotal);
                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });


       function prepareArticleByRoomsData(data) {
        const groupedData = {};
        const finalData = [];

        // Gom nhóm theo transactionCode
        data.forEach(item => {
            const key = item.transactionCode || "";
            if (!groupedData[key]) groupedData[key] = [];
            groupedData[key].push(item);
        });

               Object.entries(groupedData).forEach(([transactionCode, records]) => {
            const first = records[0];

            // 👉 Dòng tiêu đề cho nhóm
            finalData.push({
                roomNo: `Transaction: ${transactionCode}`,
                accountName: ` - ${first.trnsDescription}`,
                isTitle: true,
                cssClass: "custom"
            });

            // 👉 Dữ liệu chi tiết
            finalData.push(...records);

            // 👉 Dòng tổng cuối nhóm
            const groupTotal = {
                currencyMaster: "Transaction Total",
                 debitAmount: sum(records, 'debitAmount'),
                creditAmount: sum(records, 'creditAmount'),
                isTotal: true,
                cssClass: "custom"
            };

            finalData.push(groupTotal);
        });


        // 👉 Tổng tất cả creditAmount và debitAmount
          const grandTotal = {
        creditAmount: sum(finalData.filter(x => x.isTotal), 'creditAmount'),
        debitAmount: sum(finalData.filter(x => x.isTotal), 'debitAmount')
    };


        return { data: finalData, grandTotal };
    }

    function sum(arr, field) {
        return arr.reduce((total, item) => {
            const value = parseFloat(item[field]);
            return total + (isNaN(value) ? 0 : value);
        }, 0);
    }


    function average(arr, field) {
        const valid = arr.filter(x => x[field] != null);
        if (valid.length === 0) return 0;
        return valid.reduce((sum, x) => sum + x[field], 0) / valid.length;
    }


    function initializeJournalByCashierArticleGrid(data, grandTotal) {
        const columnWidth = 180;
            const gridInstance = $("#gridContainer").dxDataGrid("instance");
    if (gridInstance) {
        gridInstance.dispose();
        $("#gridContainer").html(""); // clear DOM trước khi render mới
    }
        $("#gridContainer").dxDataGrid({
            dataSource: data,
            allowColumnResizing: true,
            columns: [
                { dataField: "transactionDate", caption: "Date  Time", width: columnWidth - 20,dataType: "date",  format: "dd/MM/yyyy HH:mm:ss"  },
                { dataField: "roomNo", caption: "Room No", width: columnWidth - 40 },
                { dataField: "accountName", caption: "Name", width: columnWidth + 40 },
                { dataField: "articleCode", caption: "Article Code", width: columnWidth - 40 },
                { dataField: "articleDescription", caption: "Description", width: columnWidth - 40 },
                { dataField: "invoiceNo", caption: "Invoice No", width: columnWidth - 40 },
                { dataField: "supplement", caption: "Supplement", width: columnWidth - 40 },
                { dataField: "reference", caption: "Reference", width: columnWidth - 40 },
                { dataField: "cashierNo", caption: "Cashier No", width: columnWidth - 40 },
                { dataField: "currencyMaster", caption: "Curr", width: columnWidth - 40 },
                { dataField: "debitAmount", caption: "Debit", width: columnWidth - 40  , dataType: "number", format: "#,##0" },
                { dataField: "creditAmount", caption: "Credit", width: columnWidth - 40  , dataType: "number", format: "#,##0" },
                { dataField: "cashierNo", caption: "CashierNo", width: columnWidth - 40 },
                { dataField: "userName", caption: "User", width: columnWidth - 40 },
              
            ],
                 summary: {
                totalItems: [
                    {
                        name: "debitAmount",
                        column: "debitAmount",
                        summaryType: "custom",
                         customizeText: function () {
                            return grandTotal.debitAmount.toLocaleString("vi-VN", {
                                minimumFractionDigits: 0,
                                maximumFractionDigits: 0
                            });
                        }
                    },
                    {
                        column: "creditAmount",
                        summaryType: "custom",
                        name: "creditAmount",
                        customizeText: function () {
                            return grandTotal.creditAmount.toLocaleString("vi-VN", {
                                minimumFractionDigits: 0,
                                maximumFractionDigits: 0
                            });
                        }
                    }
                ]
            },
              



            paging: { pageSize: 25 },
            scrolling: {
                  mode: "standard",
            },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true
            },
            filterRow: { visible: true, applyFilter: "auto" },
            headerFilter: { visible: true },
            selection: { mode: "multiple", showCheckBoxesMode: "none" },
            showBorders: true,
             onRowPrepared: function (e) {
                if (e.rowType === "data" && e.data?.cssClass) {
                    e.rowElement.addClass(e.data.cssClass);
                }
            },
        });
    }





    $("#btnExportExcel").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
        worksheet.addRow(['Công ty Cổ phần Giải pháp Công nghệ CS-Solution']);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;
            worksheet.getCell(`A${lastRow}`).value = "--- END  ---";
            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
       $("#btnExportPdf").click(function () {
        const { jsPDF } = window.jspdf; // 👈 Bổ sung dòng này

        const doc = new jsPDF();

        DevExpress.pdfExporter.exportDataGrid({
            jsPDFDocument: doc,
            component: $("#gridContainer").dxDataGrid("instance"),
            autoTableOptions: {
                styles: { cellPadding: 2, fontSize: 8 },
                margin: { top: 20 }
            }
        }).then(() => {
            doc.save("BaoCao.pdf");
        });
    });
</script>