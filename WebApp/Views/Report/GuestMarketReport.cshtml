@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var zoneList = ViewBag.ZoneList;
    var report = ViewBag.ReportName as XtraReport;
}

<style>
    .filter_wrapper {
/*         background-color: #ececec;
        margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection {
        background-color: #01579b !important; /* màu xanh ngọc */
        color: white !important; /* chữ trắng */
    }

        #gridContainer .dx-datagrid-rowsview .dx-selection * {
            color: white !important;
        }

</style>
<div class="text-center" id="reportTitle" style="font-size: 20px">GuestMarketReport</div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <!-- From Date -->
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">From Date:</label>
            <input type="date" id="fromDate" name="fromDate" class="form-control form-control-sm w-auto" />
        </div>

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">To Date:</label>
            <input type="date" id="toDate" name="toDate" class="form-control form-control-sm w-auto" />
        </div>

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Zone:</label>
            <select id="zonecode" name="zonecode" class="form-control form-control-sm w-auto">
                @foreach (var item in zoneList)
                {
                    <option value="@item.ID">@item.Code</option>
                }
            </select>

        </div>

        <div style="display:none!important" class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">View By:</label>
            <select id="viewBy" name="viewBy" class="form-control form-control-sm w-auto">

                <option value="VND">VND</option>
                <option value="USD">USD</option>
            </select>
        </div>

    </div>
    <div class=" mb-3 ">
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnPrint" class="mui-button mui-button-new"><i class="fa-solid fa-eye"></i>View</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportExcel" class="mui-button mui-button-new" type="button"> <i class="fa-solid fa-file-excel"></i> Excel</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportPdf" class="mui-button mui-button-new" type="button"><i class="fas fa-eraser"></i> PDF</button>
    </div>
</div>
<div class="mui-card">
@*     <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridContainer" class="mt-2"></div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function formatDate(date) {
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        let day = date.getDate().toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        return `${year}-${month}-${day}`;
    }

    $(document).ready(function () {
        const today = new Date();

        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        // Lấy ngày cuối cùng của tháng
        const lastDayOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        // Định dạng theo local time
        const formattedFirstDay = formatDate(firstDayOfMonth);
        const formattedLastDay = formatDate(lastDayOfMonth);

        console.log(formattedFirstDay); // Kiểm tra giá trị đúng chưa
        console.log(formattedLastDay); // Kiểm tra giá trị đúng chưa
        // Gán giá trị cho input date
        document.getElementById('fromDate').value = formattedFirstDay;
        document.getElementById('toDate').value = formattedLastDay;



    });
         $("#btnPrint").click(function () {
            $("#loadingSpinner").show();
            $.ajax({
                 url: '/Report/GuestMarket',
                type: 'GET',
                data: {
                  fromDate: $("#fromDate").val(),
                   toDate: $("#toDate").val(),
                   zonecode: $("#zonecode").val(),
                                     currency: $("#currency").val(),
                },
                success: function (result) {
                                     console.log(result);
    const processedData = preparGuestMarketData(result);
                initializGuestMarkeGrid(processedData);
                    $("#loadingSpinner").hide();
                },
                error: function () {
                    alert("Không thể tải báo cáo.");
                    $("#loadingSpinner").hide();
                }
            });
        });
                 function preparGuestMarketData(data) {
            const groupedData = {};

            // Nhóm dữ liệu theo groupCode
            data.forEach(item => {
                const key = item.marketType;
                if (!groupedData[key]) groupedData[key] = [];
                groupedData[key].push(item);
            });

            const finalData = [];

            Object.entries(groupedData).forEach(([marketType, records]) => {
                // Tính tổng amount của nhóm

                // Dòng tiêu đề hiển thị groupCode ở cột description và tổng ở cột amount
                const titleRow = {
                    code: `${marketType}`,
                    isTitle: true,
                    cssClass: "custom",
                };
                finalData.push(titleRow);
                finalData.push(...records);

                  const totalRow = {
                    code: "TOTAL",
                    description: records[0].description,
                    d_Persons: sum(records, 'd_Persons'),
                    d_Room: sum(records, 'd_Room'),
                    _D_Occ: sum(records, '_D_Occ'),
                    d_Accom: sum(records, 'd_Accom'),
                    d_TotalAccom: sum(records, 'd_TotalAccom'),

                    m_Persons: sum(records, 'm_Persons'),
                    m_Room: sum(records, 'm_Room'),
                    _M_Occ: sum(records, '_M_Occ'),
                    m_Accom: sum(records, 'm_Accom'),
                    m_TotalAccom: sum(records, 'm_TotalAccom'),

                    y_Persons: sum(records, 'y_Persons'),
                    y_Room: sum(records, 'y_Room'),
                    _Y_Occ: sum(records, '_Y_Occ'),
                    y_Accom: sum(records, 'y_Accom'),
                    y_TotalAccom: sum(records, 'y_TotalAccom'),

                    isTotal: true,
                    cssClass: "custom" // Để phân biệt dòng tổng
                };

            finalData.push(totalRow);
                // Thêm các record
   
            });

            return finalData;
        }



         function sum(arr, field) {
            return arr.reduce((total, item) => total + (item[field] || 0), 0);
        }

        function average(arr, field) {
            const valid = arr.filter(x => x[field] != null);
            if (valid.length === 0) return 0;
            return valid.reduce((sum, x) => sum + x[field], 0) / valid.length;
        }
          function initializGuestMarkeGrid(data) {
        const columnWidth = 180;

        // Lấy ngày từ input
        const fromdate = $("#fromDate").val() || "FromDate";
        const todate = $("#toDate").val() || "ToDate";

            let year = "";

            if (todate) {
                const parts = todate.split('-');
                if (parts.length === 3) {
                    year = parts[0]; // lấy phần năm
                    console.log(year);
                }
            }
        $("#gridContainer").dxDataGrid({
            dataSource: data,
            columns: [
                { dataField: "code", caption: "Code", width: columnWidth },
                { dataField: "description", caption: "Description", width: columnWidth },

                {
                    caption: `DAY - ${todate}`,
                    alignment: "center",
                    columns: [
                        { dataField: "d_Persons", caption: "Person", width: columnWidth - 90, dataType: "number", format: "#,##0" },
                        { dataField: "d_Room", caption: "Room", width: columnWidth - 90, dataType: "number", format: "#,##0" },
                        { dataField: "_D_Occ", caption: "Occ%", width: columnWidth - 90, dataType: "number", format: { type: "fixedPoint", precision: 2 } },
                        { dataField: "d_Accom", caption: "0-Accom", width: columnWidth - 60, dataType: "number", format: { type: "fixedPoint", precision: 2 } },
                        { dataField: "d_TotalAccom", caption: "Total Accom", width: columnWidth - 60, dataType: "number", format: { type: "fixedPoint", precision: 2 } }
                    ]
                },
                {
                    caption: `${fromdate} - ${todate}`,
                    alignment: "center",
                    columns: [
                        { dataField: "m_Persons", caption: "Person", width: columnWidth - 90, dataType: "number", format: "#,##0" },
                        { dataField: "m_Room", caption: "Room", width: columnWidth - 90, dataType: "number", format: "#,##0" },
                        { dataField: "_M_Occ", caption: "Occ%", width: columnWidth - 90, dataType: "number", format: { type: "fixedPoint", precision: 2 } },
                        { dataField: "m_Accom", caption: "0-Accom", width: columnWidth - 60, dataType: "number", format: { type: "fixedPoint", precision: 2 } },
                        { dataField: "m_TotalAccom", caption: "Total Accom", width: columnWidth - 60, dataType: "number", format: { type: "fixedPoint", precision: 2 } }
                    ]
                },
                {
                    caption: `Year - ${year}`,
                    alignment: "center",
                    columns: [
                        { dataField: "y_Persons", caption: "Person", width: columnWidth - 90, dataType: "number", format: "#,##0" },
                        { dataField: "y_Room", caption: "Room", width: columnWidth - 90, dataType: "number", format: "#,##0" },
                        { dataField: "_Y_Occ", caption: "Occ%", width: columnWidth - 90, dataType: "number", format: { type: "fixedPoint", precision: 2 } },
                        { dataField: "y_Accom", caption: "0-Accom", width: columnWidth - 60, dataType: "number", format: { type: "fixedPoint", precision: 2 } },
                        { dataField: "y_TotalAccom", caption: "Total Accom", width: columnWidth - 70, dataType: "number", format: { type: "fixedPoint", precision: 2 } }
                    ]
                }
            ],
            paging: { pageSize: 25 },
            scrolling: {
                mode: 'virtual',
                useNative: true,
                showScrollbar: "always"
            },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },
            filterRow: {
                visible: true,
                applyFilter: "auto"
            },
            headerFilter: {
                visible: true
            },
            selection: { mode: "multiple", showCheckBoxesMode: "none" },
            showBorders: true,
            summary: {
                totalItems: [
                                         {
                    column: "description",
                    summaryType: "custom",
                    displayFormat: "Total"
                },
                    { column: "d_Persons", summaryType: "sum", displayFormat: " {0}", valueFormat: "#,##0" },
                    { column: "d_Room", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
                    { column: "d_Accom", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0.00" },
                    { column: "d_TotalAccom", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0.00" },

                    { column: "m_Persons", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
                    { column: "m_Room", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
                    { column: "m_Accom", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0.00" },
                    { column: "m_TotalAccom", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0.00" },

                    { column: "y_Persons", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
                    { column: "y_Room", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0" },
                    { column: "y_Accom", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0.00" },
                    { column: "y_TotalAccom", summaryType: "sum", displayFormat: "{0}", valueFormat: "#,##0.00" }
                ]
            },
            onRowPrepared: function (e) {
                if (e.rowType === "data" && e.data?.cssClass) {
                    e.rowElement.addClass(e.data.cssClass);
                }
            }
        });
    }




        $("#btnExportExcel").click(function () {
            const grid = $("#gridContainer").dxDataGrid("instance");
            var selectedReport='@ViewBag.ReportTitle';
            if (!selectedReport) {
                alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
                return;
            }

            const workbook = new ExcelJS.Workbook();
            const worksheet = workbook.addWorksheet("Sheet 1");

            DevExpress.excelExporter.exportDataGrid({
                component: grid,
                worksheet: worksheet,
                autoFilterEnabled: true
            }).then(function () {
                // Đặt tên file theo selectedReport
                let fileName =selectedReport + ".xlsx";

                // Ghi file
                workbook.xlsx.writeBuffer().then(function (buffer) {
                    saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
                });
            });
        });


        // Nút xuất PDF
           $("#btnExportPdf").click(function () {
            const { jsPDF } = window.jspdf; // 👈 Bổ sung dòng này

            const doc = new jsPDF();

            DevExpress.pdfExporter.exportDataGrid({
                jsPDFDocument: doc,
                component: $("#gridContainer").dxDataGrid("instance"),
                autoTableOptions: {
                    styles: { cellPadding: 2, fontSize: 8 },
                    margin: { top: 20 }
                }
            }).then(() => {
                doc.save("BaoCao.pdf");
            });
        });
</script>