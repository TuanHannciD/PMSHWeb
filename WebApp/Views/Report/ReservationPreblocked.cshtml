@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var roomclassList = ViewBag.RoomClassList;
    var rtList = ViewBag.RoomTypeList;
}


<style>
    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection {
        background-color: #01579b !important; /* màu xanh ngọc */
        color: white !important; /* chữ trắng */
    }

        #gridContainer .dx-datagrid-rowsview .dx-selection * {
            color: white !important;
        }

</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">From Date:</label>
            <input type="date" id="fromDate" name="fromDate" class="form-control form-control-sm w-auto" />
        </div>

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">To Date:</label>
            <input type="date" id="toDate" name="toDate" class="form-control form-control-sm w-auto" />
        </div>

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Room Class:</label>
            <select id="roomClass" name="roomClass" class="form-control form-control-sm " style="width :100px">
                <option value="">ALL</option>
                @foreach (var item in roomclassList)
                {
                    <option value="@item.Code">@item.Code</option>
                }
            </select>
        </div>

        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Room Type:</label>
            <select id="roomtype" name="roomtype" class="form-control form-control-sm " style="width :100px">
                <option value="">ALL</option>
                @foreach (var item in rtList)
                {
                    <option value="@item.Code">@item.Code</option>
                }
            </select>

        </div>

        <div class="d-flex flex-column me-3">

            <div class="d-flex flex-wrap gap-2">
                <label class="mb-1">Include</label>
                <!-- Row 1 -->
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="pseudo" name="includeOptions" value="1">
                    <label class="form-check-label" for="reservation">Pseudo Rooms</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="chkviponly" name="includeOptions" value="1">
                    <label class="form-check-label" for="chkviponly">Vip Only</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="individual" name="includeOptions" value="1">
                    <label class="form-check-label" for="checkedIn">Individual</label>
                </div>

                <!-- Row 2 -->
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="blockcode" name="includeOptions" value="1">
                    <label class="form-check-label" for="cancellation">Block Code</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input" type="checkbox" id="preblocked" name="includeOptions" value="1">
                    <label class="form-check-label" for="waitList">Preblocked Only</label>
                </div>

            </div>
        </div>





    </div>
    <div class=" mb-3 ">
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnPrint" class="mui-button mui-button-new"><i class="fa-solid fa-eye"></i>View</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportExcel" class="mui-button mui-button-new" type="button"> <i class="fa-solid fa-file-excel"></i> Excel</button>
        <button style="border-radius: 4px;  margin-right: 6px;background-color: #3b9ac6;" id="btnExportPdf" class="mui-button mui-button-new" type="button"><i class="fas fa-eraser"></i> PDF</button>
    </div>
</div>

<div class="mui-card">
    @*     <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridContainer" class="mt-2"></div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function formatDate(date) {
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        let day = date.getDate().toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        return `${year}-${month}-${day}`;
    }

    $(document).ready(function () {
    
         document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        const today = new Date();

        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        // Lấy ngày cuối cùng của tháng
        const lastDayOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        // Định dạng theo local time
        const formattedFirstDay = formatDate(firstDayOfMonth);
        const formattedLastDay = formatDate(lastDayOfMonth);

        console.log(formattedFirstDay); // Kiểm tra giá trị đúng chưa
        console.log(formattedLastDay); // Kiểm tra giá trị đúng chưa
        // Gán giá trị cho input date
        document.getElementById('fromDate').value = formattedFirstDay;
        document.getElementById('toDate').value = formattedLastDay;



    });
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/ReservationPreblockedyData',
            type: 'GET',
            data: {
                               fromDate: $("#fromDate").val(),
                     toDate: $("#toDate").val(),
                  roomClass: $("#roomClass").val(),
                   roomtype: $("#roomtype").val(),
                       pseudo: $("#pseudo").is(":checked") ? "1" : "",
    chkviponly: $("#chkviponly").is(":checked") ? "0" : "",
    individual: $("#individual").is(":checked") ? "0" : "",
    blockcode: $("#blockcode").is(":checked") ? "0" : "",
    preblocked: $("#preblocked").is(":checked") ? "0" : ""
            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
                initializReservationPreblockedyGrid(result);
                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });



    function initializReservationPreblockedyGrid(data) {
        const columnWidth = 180;
        $("#gridContainer").dxDataGrid({
    dataSource: data, allowColumnResizing: true,
            allowColumnResizing: true,
          columnResizingMode: "widget",
            columns: [
               { dataField: "roomNo", caption: "Room No", width: columnWidth-70},
            { dataField: "name", caption: "Name", width: columnWidth},
                        { dataField: "vIP", caption: "VIP", width: columnWidth-80 },
                     
                               { dataField: "arrivalDate", caption: "Arr.Date", width: columnWidth-60,  dataType: "date", format: "dd/MM/yyyy"},
                                         { dataField: "eta", caption: "ETA", width: columnWidth-70 },
            { dataField: "departureDate", caption: "Dep.Date",width: columnWidth-60,  dataType: "date", format: "dd/MM/yyyy"},
               { dataField: "etd", caption: "ETD", width: columnWidth-70 },


            { dataField: "noOfAdult", caption: "Adl.",width: columnWidth-80 ,dataType: "number", format: "#,##0" },
            { dataField: "noOfChild", caption: "Chl.", width: columnWidth-80 ,dataType: "number", format: "#,##0" },
              { dataField: "noOfChild1", caption: "Chl1.", width: columnWidth-80 ,dataType: "number", format: "#,##0" },
             { dataField: "noOfRoom", caption: "Rms", width:columnWidth-80 ,dataType: "number", format: "#,##0" },
             { dataField: "noOfNight", caption: "Nts.", width:columnWidth-80 ,dataType: "number", format: "#,##0" },
             { dataField: "hKStatusID", caption: "HK Status", width: columnWidth-70},

               { dataField: "roomType", caption: "Room Type", width:columnWidth-70 },

            { dataField: "fOStatus", caption: "Status", width: columnWidth-70},
                { dataField: "rateCode", caption: "Rate Code", width:columnWidth-70 },

                    { dataField: "rate", caption: "Rate Amount", width:columnWidth-50,dataType: "number",
    format: {
        type: "fixedPoint",
        precision: 2
    },
    customizeText: function (e) {
        return `${e.valueText}`;
    } },
                                 { dataField: "currencyID", caption: "Curr.",  width:columnWidth-70 },

                                    { dataField: "", caption: "C/H",  width:columnWidth-70 },
                  { dataField: "depositReceivedMaster", caption: "Deposit Curr.Recelved ",width: columnWidth-30 ,dataType: "number", format: "#,##0" },
                      { dataField: "depositRsqMaster", caption: "Deposit Curr.Requested ",width: columnWidth-30 ,dataType: "number", format: "#,##0" },

                                     { dataField: "resType", caption: "Res Type", width:columnWidth-70 },
            { dataField: "agent", caption: "Agent", width: columnWidth},
            { dataField: "company", caption: "Company", width: columnWidth},
             { dataField: "source", caption: "Source", width: columnWidth},
            { dataField: "businessBlockCode", caption: "Block Code", width: columnWidth-70 },
            ],
            paging: { pageSize: 25 },
      scrolling:  {
         
        useNative: true,
       showScrollbar: "always"
    },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },
            selection: { mode: "multiple", showCheckBoxesMode: "none" },
                filterRow: {
         visible: true,
        applyFilter: "auto"
    },
    headerFilter: {
        visible: true
        },summary: {
        totalItems: [
               {
                    column: "roomNo", // hoặc bất kỳ cột nào bạn muốn đếm
                    summaryType: "count",
                    displayFormat: "Total Room: {0}", // thêm {0} để hiển thị số lượng
                    valueFormat: "#,##0" // tuỳ chọn: định dạng số nếu cần
                },

            {
                column: "noOfAdult",
                summaryType: "sum",
                displayFormat: "Total: {0}",
                valueFormat: "#,##0"
            },
            {
                column: "noOfChild",
                summaryType: "sum",
                displayFormat: "{0}",
                valueFormat: "#,##0"
            },
            {
                column: "noOfChild1",
                summaryType: "sum",
                displayFormat: "{0}",
                valueFormat: "#,##0"
            }
        ]
    },

            showBorders: true,
                            onRowPrepared: function (e) {
        if (e.rowType === "data" && e.data?.cssClass) {
            e.rowElement.addClass(e.data.cssClass);
        }
    }

        });
    }




    $("#btnExportExcel").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
        worksheet.addRow(['Công ty Cổ phần Giải pháp Công nghệ CS-Solution']);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;
            worksheet.getCell(`A${lastRow}`).value = "--- END  ---";
            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
       $("#btnExportPdf").click(function () {
        const { jsPDF } = window.jspdf; // 👈 Bổ sung dòng này

        const doc = new jsPDF();

        DevExpress.pdfExporter.exportDataGrid({
            jsPDFDocument: doc,
            component: $("#gridContainer").dxDataGrid("instance"),
            autoTableOptions: {
                styles: { cellPadding: 2, fontSize: 8 },
                margin: { top: 20 }
            }
        }).then(() => {
            doc.save("BaoCao.pdf");
        });
    });
</script>