@{
    ViewData["Title"] = "Search Profile";
}

<style>
    .filter_wrapper {
        background-color: #ececec;
        margin: 0px 8px 14px 8px;
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection {
        background-color: #01579b !important; /* màu xanh ngọc */
        color: white !important; /* chữ trắng */
    }

        #gridContainer .dx-datagrid-rowsview .dx-selection * {
            color: white !important;
        }

</style>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<div style="display:flex;margin: 12px;text-align:center">
    <i class="fa-solid fa-arrow-left" style="padding-top:5px;margin-right:4px" onclick="window.location.href='@Url.Action("Index", "Home")'"></i>
    <div style="font-size:18px"><b>Profile/Search Profile</b></div>
</div>
<div class="button_wrapper row">
    <button type="button" class="btn btn-primary col-lg-1 mb-4 col-col-6" onclick="window.location.href='@Url.Action("Index", "Profile")'"><i class="fa-solid fa-folder-plus"></i>New</button>
    <button type="button" class="btn btn-warning col-lg-1 mb-4 col-col-6"  onclick="editProfile();"><i class="fa-solid fa-pen-to-square"></i>Edit</button>
    <button type="button" class="btn btn-danger col-lg-1 mb-4 col-sm-6"  onclick="DeleteProfile();"><i class="fa-solid fa-pen-to-square"></i>Delete</button>
    <button type="button" class="btn btn-secondary col-lg-1 mb-4" ><i class="fa-solid fa-rotate"></i>Clear</button>
    <button type="button" class="btn btn-success col-lg-1 mb-4"  onclick="ReservationProfile();"><i class="fa-solid fa-file-import"></i>Resv</button>
    <button type="button" class="btn btn-info col-lg-1 mb-4"><i class="fa-solid fa-gears"></i>Option</button>
    <button type="button" class="btn btn-light col-lg-1 mb-4" >Future</button>
    <button type="button" class="btn btn-dark col-lg-1 mb-4" ><i class="fa-solid fa-repeat"></i>Merge</button>
    <button type="button" class="btn btn-success col-lg-1 mb-4" ><i class="fa-solid fa-file-excel"></i>Excel</button>
</div>
<div class="filter_wrapper row">
    <div class="form-group row col-md-3 mb-3">
        <label for="inputPassword" class="col-md-5 col-form-label text-right">View By</label>
        <div class="col-md-7">
            <select type="text" class="form-select" id="txtType">
                <option value="0">Travel Agent</option>
                <option value="1">Company</option>
                <option value="2">Source</option>
                <option value="3">Individual</option>
                <option value="4">Group</option>
                <option value="4">Contact</option>
                <option value="6" selected>View All</option>
            </select>
        </div>
    </div>
    <div class="form-group row col-md-3 mb-3">
        <label for="inputPassword" class="col-md-5 col-form-label text-right">Name</label>
        <div class="col-md-7">
            <input type="text" class="form-control" id="txtAccount" oninput="getAllProfiles()">
        </div>
    </div>
    <div class="form-group row col-md-3 mb-3">
        <label for="inputPassword" class="col-md-5 col-form-label text-right">Key word</label>
        <div class="col-md-7">
            <input type="text" class="form-control" id="txtKeyword" oninput="getAllProfiles()">
        </div>
    </div>
    <div class="form-group row col-md-3 mb-3">
        <label for="inputPassword" class="col-md-5 col-form-label text-right">First</label>
        <div class="col-md-7">
            <input type="text" class="form-control" id="txtFirstName" oninput="getAllProfiles()">
        </div>
    </div>
    <div class="form-group row col-md-3 mb-3">
        <label for="inputPassword" class="col-md-5 col-form-label text-right" oninput="getAllProfiles()">Code</label>
        <div class="col-md-7">
            <input type="text" class="form-control" id="txtCode">
        </div>
    </div>
    <div class="form-group row col-md-3 mb-3">
        <label for="inputPassword" class="col-md-5 col-form-label text-right">City</label>
        <div class="col-md-7">
            <select type="text" class="form-select" id="txtCity">
            </select>
        </div>
    </div>
    <div class="form-group row col-md-3 mb-3">
        <label for="inputPassword" class="col-md-5 col-form-label text-right">Property</label>
        <div class="col-md-7">
            <select type="text" class="form-select" disabled>
                <option value="value">PMSh The Arena</option>
            </select>
        </div>
    </div>
    <div class="form-group row col-md-3 mb-3">
        <label for="inputPassword" class="col-md-5 col-form-label text-right" style="display:none">Property</label>

        <div class="col-md-7 d-flex align-items-center">
            <input type="checkbox" class="form-check-input" id="saleInCharge">
            <label for="saleInCharge" class="form-check-label ms-2">Sale In Charge</label>
        </div>
    </div>


</div>
