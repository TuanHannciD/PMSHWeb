                $('#txtFirstName').val(lastName);
                $('#nameProfileSearch').val(name);
                $('#txtItemInventory').prop('disabled', false); // Enable the select element
            } else {
                showToast('Error', 'Invalid name format! Use FirstName MiddleName LastName or FirstName MiddleName,LastName', false);
                $('#txtName').val('');
                $('#txtFirstName').val('');
                $('#txtItemInventory').prop('disabled', true); // Keep the select element disabled
            }
        } else {
            $('#txtItemInventory').prop('disabled', true); // Keep disabled if name is empty
