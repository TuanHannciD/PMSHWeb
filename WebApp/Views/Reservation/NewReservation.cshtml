﻿
<link href="~/css/new_reservation.css" rel="stylesheet" asp-append-version="true" />
<div class="body">
    @*     <div id="loading" class="loading">
        <div class="spinner"></div>
        <p id="loading-text">Loading data ... <span id="progress">0%</span></p>
    </div> *@
    <div class="container2">
        <div>
            <div class="text-center" style="font-size: 20px;">Reservation</div>            
            <div class="button-group mb-1">
                <div>
                    <button class="mui-button mui-button-new"><i class="fas fa-plus"></i> Save</button>
                    <button class="mui-button mui-button-new"><i class="fas fa-eraser"></i> Clear</button>
                    <button class="mui-button mui-button-new" onclick="window.location.href='@Url.Action("Index", "Home")'"><i class="fas fa-times"></i> Close</button>
                </div>
                
                <div><a href="#" style="text-decoration:none">Search reservation  <i class="fa-solid fa-angles-right"></i></a></div>
            </div>
        </div>
        <div class="top-row">
            <div class="section">
                <div class="row me-1">
                    <label class="col-md-3">Name</label>
                    <input class="col-md-8" id="txtName"/>
                    <button class="col-md-1" onclick="openModalSearchProfile(3)"><i class="fa-solid fa-ellipsis"></i></button>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">First name</label>
                    <input class="col-md-9" type="text" id="txtFirstName">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Title</label>
                    <select class="col-md-9" id="txtTitle" asp-items="ViewBag.cboTitle">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Phone</label>
                    <input class="col-md-9" type="text" id="txtPhone">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Email</label>
                    <input class="col-md-9" type="email" id="txtEmail">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Identity Card</label>
                    <input class="col-md-9" type="text" id="txtIdentityCard">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Passport</label>
                    <input class="col-md-9" type="text" id="txtPassport">
                </div>
            </div>

            <div class="section">
                <div class="row me-1">
                    <label class="col-md-3">Address</label>
                    <input class="col-md-9" type="text" id="txtAddress">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Date of Birth</label>
                    <input class="col-md-9" type="date" value="1900-01-01" id="txtDob">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Nationality</label>
                    <select class="col-md-9" id="txtNationality" asp-items="ViewBag.cboNationality">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">City</label>
                    <select class="col-md-9" id="txtCity" asp-items="ViewBag.cboCity">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">VIP</label>
                    <select class="col-md-9" id="txtVIP" asp-items="ViewBag.cboVIP">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Mem. Type</label>
                    <select class="col-md-9" id="txtMemberType" asp-items="ViewBag.cboMemberType">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Card No.</label>
                    <input class="col-md-9" type="text" id="txtCardNo">
                </div>
            </div>

            <div class="section">
                <div class="row me-1">
                    <label class="col-md-3">Agent</label>
                    <select class="col-md-9" id="txtAgent" asp-items="ViewBag.cboProfileAgent">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Company</label>
                    <select class="col-md-9" id="txtCompany" asp-items="ViewBag.cboProfileCompany">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Group Code</label>
                    <input class="col-md-9" type="text" id="txtGroupCode">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Contact</label>
                    <select class="col-md-9" id="txtContact" asp-items="ViewBag.cboProfileContact">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Con. Phone</label>
                    <input class="col-md-9" type="text" id="txtContactPhone">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Pref. Room</label>
                    <input class="col-md-9" type="text" id="txtPrefRoom">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Last Stay</label>
                    <input class="col-md-9" type="text" id="txtLastStay" value="1">
                </div>
            </div>
        </div>


        <div class="section" style="display: flex; align-items: center;">
            <div class="row">            
                <button onclick="openModalMoreFields()" style="margin-left:12px">More Fields</button>
            </div>
            <div style="flex: 1; text-align: center;color:#9F0010;font-size:20px;font-weight:600">
                Property : Pmsh The Arena
            </div>
        </div>


        <div class="third-row">
            <!-- Arrival Section -->
            <div class="section">
                <div class="row me-1">

                    <label class="col-md-3">Arrival</label>
                    <input type="date" id="arrival" class="col-md-5">
                    <button class="col-md-1" onclick="changeDate('arrival', -1)">-</button>
                    <button class="col-md-1" onclick="changeDate('arrival', 1)">+</button>
                    <span class="col-md-2" style="font-size:12px;color:#9F0010" id="arrival-day"></span>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Nights</label>
                    <input type="text" id="nights" class="col-md-9" readonly>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Departure</label>
                    <input type="date" id="departure" class="col-md-5">
                    <button class="col-md-1" onclick="changeDate('departure', -1)">-</button>
                    <button class="col-md-1" onclick="changeDate('departure', 1)">+</button>
                    <span class="col-md-2" style="font-size:12px;color:#9F0010" id="departure-day"></span>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Adults</label>
                    <input type="number" value="2" class="small-input col-md-3" id="adults">
                    <label class="col-md-1">C</label>
                    <input type="number" value="0" class="small-input col-md-1" id="c">
                    <label class="col-md-1">C1</label>
                    <input type="number" value="0" class="small-input col-md-1" id="c1">
                    <label class="col-md-1">C2</label>
                    <input type="number" value="0" class="small-input col-md-1" id="c2">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">No. of Room</label>
                    <input class="col-md-7" type="number" id="numRooms" value="1" min="1">
                    <button class="col-md-1" onclick="decreaseRooms()">-</button>
                    <button class="col-md-1" onclick="increaseRooms()">+</button>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Room Type</label>
                    <select class="col-md-4" id="txtRoomType" asp-items="ViewBag.cboRoomType">
                    </select>
                    <label class="col-md-2">RTC</label>
                    <select class="col-md-3" id="txtRTC" asp-items="ViewBag.cboRoomType">
                    </select>
                </div>

                <div class="row me-1">
                    <label class="col-md-3">Room</label>
                    <input class="col-md-4" id="roomSelect"/>
                    <button class="col-md-1" onclick="openModalSearchRoom()"><i class="fa-solid fa-ellipsis"></i></button>

                    <label class="col-md-1">RN</label>
                    <input class="col-md-3" id="txtRN"/>
                </div>

                <div class="row me-1">
                    <label class="col-md-3">Rate Code</label>
                    <input class="col-md-8" id="txtRateCode"/>
                    <button class="col-md-1" onclick="openModalRateCode()"><i class="fa-solid fa-ellipsis"></i></button>

                </div>
                <div class="row me-1">
                    <label class="col-md-3">Currency</label>
                    <select class="col-md-9" asp-items="ViewBag.cboCurrency">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Rate</label>
                    <input class="col-md-3" type="number" value="0.00">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Packages</label>
                    <select class="col-md-9" id="txtPackage" asp-items="ViewBag.cboPackage">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Allotment</label>
                    <input class="col-md-8" id="txtAllotment"/>
                    <button class="col-md-1" onclick="openModalSearchAllotment()"><i class="fa-solid fa-ellipsis"></i></button>

                </div>
                <div class="row me-1">
                    <label class="col-md-3">Disc. Amt</label>
                    <input type="number" value="0.00" class="col-md-3">
                    <label class="col-md-1">%</label>
                    <input type="number" value="0.00" class="col-md-5">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Reason</label>
                    <select class="col-md-9" id="txtReason" asp-items="ViewBag.cboReason">
                    </select>
                </div>
            </div>

            <!-- Res. Type Section -->
            <div class="section">
                <div class="row me-1">
                    <label class="col-md-3">Res. Type</label>
                    <select class="col-md-9" asp-items="ViewBag.cboReservationType" id="txtResType">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Market</label>
                    <input class="col-md-8" id="txtMarket"/>
                    <button class="col-md-1" onclick="openModalSearchMarket()"><i class="fa-solid fa-ellipsis"></i></button>

                </div>
                <div class="row me-1">
                    <label class="col-md-3">Source</label>
                    <select class="col-md-9" id="txtSource" asp-items="ViewBag.cboSource">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Sale</label>
                    <select class="col-md-9" id="txtPersonInCharge" asp-items="ViewBag.cboPersonInCharge">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Payment</label>
                    <select class="col-md-9" id="txtPayment" asp-items="ViewBag.cboPaymentMethod">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">CRS No</label>
                    <input class="col-md-9" type="text">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Booker</label>
                    <input class="col-md-8" id="txtBooker"/>
                    <button class="col-md-1" onclick="openModalSearchBooker()"><i class="fa-solid fa-ellipsis"></i></button>

                </div>
                <div class="row me-1">
                    <label class="col-md-3">ETA</label>
                    <input class="col-md-3" type="time" value="06:00">
                    <label class="col-md-2">ETD</label>
                    <input class="col-md-4" type="time" value="12:00">
                </div>

                <div class="row me-1">
                    <label class="col-md-3">Rate</label>
                    <div class="col-md-5 row">
                        <div class="row col-md-12">
                            <input type="number" value="0" class="highlighted col-md-9">
                            <span class="col-md-3">+</span>
                        </div>
                        <div class="row col-md-12">
                            <input type="number" style="font-size:12px" value="0" class="highlighted col-md-9">
                            <span class="col-md-3" style="font-size:12px">net</span>
                        </div>
                    </div>
                    <div class="col-md-4 row" style="text-align:center;justify-content:center">
                        <span style="font-size:12px;color:red;padding-top:8px">
                            Rate amount
                            after discount
                        </span>
                    </div>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Total</label>
                    <div class="col-md-5 row">
                        <div class="row col-md-12">
                            <input type="number" value="0" class="highlighted col-md-9">
                            <span class="col-md-3">+</span>
                        </div>
                        <div class="row col-md-12">
                            <input type="number" style="font-size:12px" value="0" class="highlighted col-md-9">
                            <span class="col-md-3" style="font-size:12px">net</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Specials Section -->
            <div class="section ">
                <div class="row me-1">
                    <label class="col-md-3">Specials</label>
                    <input class="col-md-8" id="txtPreference" />
                    <button class="col-md-1" onclick="openModalSearchPreference()"><i class="fa-solid fa-ellipsis"></i></button>

                </div>
                <div class="row me-1">
                    <label class="col-md-3">Promotions</label>
                    <select class="col-md-9" id="txtPromotion" asp-items="ViewBag.cboPromotion">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Item .Inv</label>
                    <select class="col-md-9">
                    </select>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Folio Bal</label>
                    <input class="col-md-4" type="number" value="0.00">
                    <label class="col-md-1" style="font-size:12px;color:red;">$</label>
                    <input class="col-md-3" type="number" value="0.00">
                    <label class="col-md-1" style="font-size:12px;color:red;">VND</label>
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Set Color</label>
                    <input class="col-md-9" type="color">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">Print Rate</label>
                    <input class="col-md-1" type="checkbox">
                    <label class="col-md-3">Video C/Out</label>
                    <input class="col-md-1" type="checkbox">
                </div>
                <div class="row me-1">
                    <label class="col-md-3">No Post</label>
                    <input class="col-md-1" type="checkbox">
                    <label class="col-md-3">Confirmation</label>
                    <input class="col-md-1" type="checkbox">
                </div>

                <div class="row me-1">
                    <label class="col-md-3">Comments</label>
                    <textarea rows="3" class="specials-section col-md-9"></textarea>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="nameToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto" id="toastTitle">Notification</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="toastMessage"></div>
    </div>
</div>
<!-- Modal search profile-->
<div class="modal fade modal-xl" id="modalProfile" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Search Profile</h5>
                <button type="button" class="btn-close" onclick="closeModalSearchProfle()"></button>
            </div>
            <div class="modal-body">
                <div class="row mui-card mb-2">
                    <div class="col-md-2 mb-2">
                        <label for="input1" class="form-label">Full Name</label>
                        <input type="text" class="form-control" id="nameProfileSearch" placeholder="Enter name" oninput="filterProfileModal()">
                    </div>
                    <div class="col-md-2 mb-2">
                        <label for="input2" class="form-label">First Name</label>
                        <input type="text" class="form-control" id="firstNameProfileSearch" placeholder="Enter first name" oninput="filterProfileModal()">
                    </div>
                    <div class="col-md-2 mb-2">
                        <label for="input3" class="form-label">View By</label>
                        <select type="text" class="form-control" id="viewByProfileSearch" disabled style="line-height:1.28">
                            <option selected value="3">Individual</option>
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <label for="input4" class="form-label">City</label>
                        <select type="text" class="form-control" id="cityProfileSearch" placeholder="Enter value" asp-items="ViewBag.cboCity" style="line-height:1.28"></select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <label for="input5" class="form-label">Key word</label>
                        <input type="text" class="form-control" id="keywordProfileSearch" placeholder="Enter value" oninput="filterProfileModal()">
                    </div>
                    <div class="col-md-2 mb-2">
                        <label for="input6" class="form-label">Code</label>
                        <input type="text" class="form-control" id="codeProfileSearch" placeholder="Enter value" oninput="filterProfileModal()">
                    </div>
                    <div class="col-md-2 mb-2">
                        <label for="input4" class="form-label">Property</label>
                        <select type="text" class="form-control" id="propertyProfileSearch" disabled style="line-height:1.28">
                            <option selected>PMSh TheArena</option>
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <label >Sale in charge</label>
                        <div>
                            <input type="checkbox" id="sale" name="myCheckbox">
                        </div>
                    </div>
                </div>
                <div id="loadingSpinner" style="display: none; text-align: center; padding: 20px;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
                <div class="mui-card">
                    <div id="gridContainerSearchProfile" class="mt-2 gridContainer"></div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Modal search room-->
<div class="modal fade modal-xl" id="modalRoom" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Available Room Search</h5>
                <button type="button" class="btn-close" onclick="closeModalSearchRoom()"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <button class="mui-button mui-button-new" onclick="getAllRooms();"><i class="fas fa-search"></i> Search</button>
                    <button class="mui-button mui-button-new" onclick="clearModelSearchRoom();"><i class="fas fa-eraser"></i> Clear</button>
                </div>
                <div class="row mui-card mb-2">
                    <div class="row">
                        <div class="col-md-2 mb-2">
                            <label for="input1" class="form-label">RoomType</label>
                            <select type="text" class="form-control" id="roomTypeSearch" asp-items="ViewBag.cboRoomType">
                            </select>
                        </div>
                        <div class="col-md-2 mb-2">
                            <label for="input2" class="form-label">Smoking</label>
                            <select type="text" class="form-control" id="smokingSearch">
                                <option value="2">---Select all ---</option>
                                <option value="1">Smoking</option>
                                <option value="0">No Smoking</option>

                            </select>
                        </div>
                        <div class="col-md-2 mb-2">
                            <label for="input3" class="form-label">RoomNo</label>
                            <input type="text" class="form-control" id="roomNoSearch" />
                        </div>
                        <div class="col-md-2 mb-2">
                            <label for="input4" class="form-label">Floor</label>
                            <input type="text" class="form-control" id="floorSearch">
                        </div>
                        <div class="col-md-2 mb-2">
                            <label for="input5" class="form-label">From</label>
                            <input type="date" class="form-control" id="fromSearch">
                        </div>
                        <div class="col-md-2 mb-2">
                            <label for="input6" class="form-label">To</label>
                            <input type="date" class="form-control" id="toSearch">
                        </div>
                    </div>
                    <div class="form-group" style="display:flex">
                        <label>FO Status</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="foStatus" checked value="0">
                            <label class="form-check-label" for="foActive">Vacant</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="foStatus" value="1">
                            <label class="form-check-label" for="foInactive">Occupied</label>
                        </div>
                    </div>
                    <div class="form-group" style="display:flex">
                        <label>HK Status</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="hkStatus"  value="1">
                            <label class="form-check-label" for="hkClean">Clean Non-checked Rooms</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="hkStatus" value="2">
                            <label class="form-check-label" for="hkDirty">Dirty Rooms</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="hkStatus"  value="4">
                            <label class="form-check-label" for="hkInProgress">Clean Rooms</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="hkStatus"  value="5">
                            <label class="form-check-label" for="hkOutOfService">OOC Rooms</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="hkStatus"  value="6">
                            <label class="form-check-label" for="hkInspected">OOS Rooms</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="hkDummy">
                            <label class="form-check-label" for="hkOccupied">Pseudo (Dummy) Roóm</label>
                        </div>
                    </div>
                </div>
                <div id="loadingSpinnerRoom" style="display: none; text-align: center; padding: 20px;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
                <div class="mui-card">
                    <div id="gridContainerSearchRoom" class="mt-2 gridContainer"></div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Modal search allotment-->
<div class="modal fade modal-xl" id="modalAllotment" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Search Profile</h5>
                <button type="button" class="btn-close" onclick="closeModalSearchAllotment()"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <button class="mui-button mui-button-new" onclick="getAllotment();"><i class="fas fa-search"></i> Search</button>
               </div>
