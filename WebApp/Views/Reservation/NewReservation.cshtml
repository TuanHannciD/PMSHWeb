        function initializeDataGridSearchRateCode(data) {
            $("#gridContainerRateCode").dxDataGrid({
                dataSource: data,
                allowColumnResizing: true,
                columnAutoWidth: true,
                columnMinWidth: 90,
                paging: { pageSize: 15 },
