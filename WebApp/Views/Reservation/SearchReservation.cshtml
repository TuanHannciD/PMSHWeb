        function getBusinessDate() {
            return $.ajax({
                url: '/Reservation/GetBusinessDate',
                type: 'get',
                dataType: 'json',
                crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
                success: function (result) {

                    // Lấy ngày từ result (giả sử result có định dạng ISO như 'YYYY-MM-DDTHH:mm:ss')
                    const businessDate = new Date(result);
                    $('#arrivalForm').val(result.split('T')[0]);
                    // $('#dayInput').val(result.split('T')[0]);
                    // $('#dateInput').val(result.split('T')[0]);

                    // Cộng 7 ngày
                    const departureDate = new Date(businessDate);
                    departureDate.setDate(businessDate.getDate() + 7);

                    // Định dạng ngày thành YYYY-MM-DD
                    const formattedDepartureDate = departureDate.toISOString().split('T')[0];
                    $('#departureForm').val(formattedDepartureDate);
                },
                error: function (xhr, statusText, err) {
                    if (xhr.status == 401) {
                        sessionTimeout();
                    }
                }
            });
        }

