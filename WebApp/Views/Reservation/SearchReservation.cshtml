<link href="~/css/reservation.css" rel="stylesheet" />
<div class="mt-3">
    <div class="row">
        <!-- Menu trái -->
        <div class="col-md-2 mb-2">
            <div class="menu-left">
                <button class="toggle-btn"><i class="fas fa-bars"></i></button>
                <a class="menu-item " href="/Reservation/NewReservation">NEW RESERVATION</a>
                <a class="menu-item active">SEARCH RESERVATION</a>
                <a class="menu-item " href="/Reservation/GroupReservation" >GROUP RESERVATION</a>
            </div>
        </div>

        <!-- Nội dung bên phải -->
        <div class="col-md-10">
            <div class="content-right">
                <div class="header">
                    <h3 id="content-title">Search Reservation
             
                    </h3>
                    <i class="fas fa-info-circle info-icon" title="Reservation Lookup Information"></i>
                </div>

                <div id="partial-content">
                    <!-- Tab menu -->
                    <div class="tab-menu">
                        <div class="tab active" data-tab="tab-filter">Filter <i class="fas fa-minus tab-icon"></i></div>
                        <div class="tab" data-tab="tab-functions">Functions <i class="fas fa-plus tab-icon"></i></div>
                        <div class="tab" data-tab="tab-options">Options <i class="fas fa-plus tab-icon"></i></div>
                    </div>
                    <!-- Tab nội dung -->
                    <div class="tab-content mt-2">
                        <!-- FILTER -->
                        <div id="tab-filter" class="tab-pane active">
                            <div class="filter-section">
                                <h4>Guest Information & Reservation Details</h4>
                                <div class="form-group">
                                    <label>First Name</label>
                                    <input type="text" class="form-control" placeholder="Enter first name" id="firstName">
                                </div>
                                <div class="form-group">
                                    <label>Name</label>
                                    <input type="text" class="form-control" placeholder="Enter full name" id="name">
                                </div>
                                <div class="form-group">
                                    <label>Owner</label>
                                    <select class="form-select" id="owner">
                                        <option value="">--All--</option>
                                        <option value="--Hotel--">--Hotel--</option>
                                        <option value="--Owner--">--Owner--</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Conf. No</label>
                                    <input type="text" class="form-control" placeholder="Enter confirmation number" id="confirmationNo">
                                </div>
                                <div class="form-group">
                                    <label>Resv. No</label>
                                    <input type="text" class="form-control" placeholder="Enter reservation number" id="resvHolder">
                                </div>
                                <div class="form-group">
                                    <label>CRS No/GC</label>
                                    <input type="text" class="form-control" placeholder="Enter CRS or group code" id="crsNo">
                                </div>
                                <div class="form-group">
                                    <label>Search Type</label>
                                    <select class="form-select" id="searchType">
                                        <option value="0">General</option>
                                        <option value="7">Cancellations</option>
                                    </select>
                                </div>
                            </div>
                            <div class="filter-section">
                                <h4>Room Information & Dates</h4>
                                <div class="form-group">
                                    <label>Package</label>
                                    <input type="text" class="form-control" placeholder="Enter package name" id="package">
                                </div>
                                <div class="form-group">
                                    <label>Zone</label>
                                    <select class="form-select" id="zone" asp-items="ViewBag.cboZone">
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Room No</label>
                                    <input type="text" class="form-control" placeholder="Enter room number" id="roomNo">
                                </div>
                                <div class="form-group">
                                    <label>Room Type</label>
                                    <select class="form-select" id="roomType" asp-items="ViewBag.cboRoomType">
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Arrival</label>
                                    <input type="date" class="form-control" id="arrivalForm">
                                </div>
                                <div class="form-group">
                                    <label>Departure</label>
                                    <input type="date" class="form-control" id="departureForm">
                                </div>
                                <div class="form-group checkbox-group">
                                    <label>Rsv Online</label>
                                    <input type="checkbox" id="reservationOnline" name="reservationOnline" value="1">
                                </div>
                                <div class="form-group checkbox-group">
                                    <label>Room Sharer</label>
                                    <input type="checkbox" id="roomShare" name="roomShare" value="IncludeRS" checked>
                                </div>
                            </div>
                        </div>
                        <div id="tab-functions" class="tab-pane" style="display: none;">
                            <div class="functions-pane">
                                <div class="function-menu">
                                    <a href="#">Advance</a>
                                    <a href="#">Clear</a>
                                    <a href="#" onclick="openModalEdit();">Edit</a>
                                    <a href="#" onclick="openModalCancel()">Cancel</a>
                                    <a href="#" onclick="openConfirmReinstate();">Reinstate</a>
                                    <a href="#" onclick="openModalRegistrationCard();">Reg.Card</a>
                                    <a href="#" onclick="checkIn();">Check In</a>
                                    <a href="#" onclick="openModalViewProfile();">View Profile</a>
                                    <a href="#" id="groupAdmin">Group Admin</a>
                                    <a href="#" data-function="export">Export</a>
                                    <a href="#" onclick="openModalSplit();">Split</a>
                                    <div class="dropdown">

                                        <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown">Room Assignment</a>
                                        <div class="dropdown-menu-custom">
                                            <a href="#" onclick="openRoomAssignment();" id="assignRoom">Assignment</a>
                                            <a href="#" onclick="openConfirmRoomUnAssign();" id="unAssignRoom">UnAssign</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- OPTIONS -->
                        <div id="tab-options" class="tab-pane" style="display: none;">
                            <div class="functions-pane">
                                <div class="function-menu">
                                    <a class="rs-bold" onclick="openModalAccompanying();">Accompanying</a>
                                    <a class="rs-bold" onclick="openModalAddOn();">Add On</a>
                                    <a class="rs-bold">Alerts</a>
                                    <a class="rs-bold" onclick="openModalBilling();">Billing</a>
                                    <a class="rs-bold" onclick="openModalCancel()">Cancel</a>
                                    <a class="rs-bold">Change</a>
                                    <a class="rs-bold" onclick="openModalShare();">Share</a>
                                    <a class="rs-bold" onclick="openModalDeposit();">Deposit/DXL</a>
                                    <a class="rs-bold" onclick="openModalFixedCharges();">Fixed Charges</a>
                                    <a class="rs-bold" onclick="openConfirm();">Delete</a>
                                    <a class="rs-bold" onclick="openModalMessage();">Message</a>
                                    <a class="rs-bold" onclick="openModalRegistrationCard();">Regis.Card</a>
                                    <a class="rs-bold" onclick="openRoomMove();">Room move</a>
                                    <a class="rs-bold" onclick="openModalRouting();">Routing</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="loadingSpinnerForm" style="display: none; text-align: center; padding: 20px;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <!-- DevExtreme DataGrid -->
                    <div id="gridContainer" class="gridContainer mt-2"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Model edit *@
<div class="modal fade modal modal-xl" id="modalEdit" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Add On</h5>
                <button type="button" class="btn-close" onclick="closeModalEdit()"></button>
            </div>
            <div class="modal-body" style="padding-top:0">
                <div class="button-group mb-1">
                    <div>
                        <button class="mui-button mui-button-new" onclick="EditReservation();"><i class="fa-solid fa-floppy-disk"></i></i> Save</button>
                        <button class="mui-button mui-button-clear" onclick="resetForm()"><i class="fas fa-eraser"></i> Clear</button>
                    </div>

                </div>
                <div class="container-new-reservation body">
                    <!-- Guest Information -->
                    <div class="section-new-reservation">
                        <h3>Guest Information</h3>
                        <div class="form-grid-new-reservation">
                            <div class="form-group-new-reservation">
                                <label for="txtName">Name</label>
                                <select id="txtName"></select>
                            </div>
                            <div class="form-group-new-reservation" style="margin-right: 20px;">
                                <label for="txtFirstName">First Name</label>
                                <input type="text" id="txtFirstName" readonly>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtTitle">Title</label>
                                <select id="txtTitle" asp-items="ViewBag.cboTitle"></select>
                            </div>
                            <div class="form-group-new-reservation" style="margin-right: 20px;">
                                <label for="txtPhone">Phone</label>
                                <input type="text" id="txtPhone">
                            </div>
                            <div class="form-group-new-reservation" style="margin-right:20px;">
                                <label for="txtPassport">Passport</label>
                                <input type="text" id="txtPassport">
                            </div>
                            <div class="form-group-new-reservation" style="margin-right: 20px;">
                                <label for="txtIdentityCard">Identity Card</label>
                                <input type="text" id="txtIdentityCard">
                            </div>
                            <div class="form-group-new-reservation full-width-new-reservation" style="margin-right: 20px;">
                                <label for="txtEmail">Email</label>
                                <input type="email" id="txtEmail">
                            </div>
                            <input type="hidden" id="txtID" />
                        </div>
                    </div>

                    <!-- Membership Information -->
                    <div class="section-new-reservation">
                        <h3>Membership Information</h3>
                        <div class="form-grid-new-reservation">
                            <div class="form-group-new-reservation full-width-new-reservation">
                                <label for="txtAddress">Address</label>
                                <input type="text" id="txtAddress">
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtDob">Date of Birth</label>
                                <input type="date" id="txtDob">
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtNationality">Nationality</label>
                                <select id="txtNationality" asp-items="ViewBag.cboNationality"></select>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtCity">City</label>
                                <select id="txtCity" asp-items="ViewBag.cboCity"></select>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtVIP">VIP</label>
                                <select id="txtVIP" asp-items="ViewBag.cboVIP"></select>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtMemberType">Member Type</label>
                                <select id="txtMemberType" asp-items="ViewBag.cboMemberType"></select>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtCardNo">Card No.</label>
                                <input type="text" id="txtCardNo">
                            </div>
                        </div>
                    </div>

                    <!-- Agent Information -->
                    <div class="section-new-reservation">
                        <h3>Agent Information</h3>
                        <div class="form-grid-new-reservation">
                            <div class="form-group-new-reservation">
                                <label for="txtAgent">Agent</label>
                                <select id="txtAgent" asp-items="ViewBag.cboProfileAgent"></select>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtCompany">Company</label>
                                <select id="txtCompany" asp-items="ViewBag.cboProfileCompany"></select>
                            </div>
                            <div class="form-group-new-reservation" style="margin-right: 20px;">
                                <label for="txtGroupCode">Group Code</label>
                                <input type="text" id="txtGroupCode">
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtContact">Contact</label>
                                <select id="txtContact" asp-items="ViewBag.cboProfileContact"></select>
                            </div>
                            <div class="form-group-new-reservation" style="margin-right: 20px;">
                                <label for="txtContactPhone">Contact Phone</label>
                                <input type="text" id="txtContactPhone">
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtPrefRoom">Preferred Room</label>
                                <input type="text" id="txtPrefRoom">
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtLastStay">Last Stay</label>
                                <input type="text" id="txtLastStay" value="1">
                            </div>
                            <div class="form-group-new-reservation">
                                <button onclick="openModalMoreFields()">More Fields</button>
                            </div>
                        </div>
                    </div>

                    <!-- Stay Details -->
                    <div class="section-new-reservation">
                        <h3>Stay Details</h3>
                        <div class="stay-details-grid-new-reservation">
                            <div class="form-group-new-reservation">
                                <label for="arrival">Arrival</label>
                                <div class="action-button-new-reservation">
                                    <input type="date" id="arrival">
                                    <button onclick="changeDate('arrival', -1)">-</button>
                                    <button onclick="changeDate('arrival', 1)">+</button>
                                    <span style="font-size:12px;color:#c53030;display:none" id="arrival-day"></span>
                                </div>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="departure">Departure</label>
                                <div class="action-button-new-reservation">
                                    <input type="date" id="departure">
                                    <button onclick="changeDate('departure', -1)">-</button>
                                    <button onclick="changeDate('departure', 1)">+</button>
                                    <span style="font-size:12px;color:#c53030;display:none" id="departure-day"></span>
                                </div>
                            </div>
                            <div class="form-group-new-reservation" style="width: 100px;">
                                <label for="nights">Nights</label>
                                <input type="text" id="nights" readonly style="text-align:right">
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="numRooms">No. of Rooms</label>
                                <div class="action-button-new-reservation">
                                    <input type="number" id="numRooms" value="1" min="1" style="text-align:right">
                                    <button onclick="decreaseRooms()">-</button>
                                    <button onclick="increaseRooms()">+</button>
                                </div>
                            </div>
                            <div class="guest-count-row-new-reservation">
                                <div class="form-group-new-reservation">
                                    <label for="adults">Adults</label>
                                    <input type="number" value="2" id="adults" style="text-align:right">
                                </div>
                                <div class="form-group-new-reservation">
                                    <label for="c">Child (C)</label>
                                    <input type="number" value="0" id="c" style="text-align:right">
                                </div>
                                <div class="form-group-new-reservation">
                                    <label for="c1">Child (C1)</label>
                                    <input type="number" value="0" id="c1" style="text-align:right">
                                </div>
                                <div class="form-group-new-reservation">
                                    <label for="c2">Child (C2)</label>
                                    <input type="number" value="0" id="c2" style="text-align:right">
                                </div>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtRoomType">Room Type</label>
                                <select id="txtRoomType" asp-items="ViewBag.cboRoomType"></select>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtRTC">RTC</label>
                                <select id="txtRTC" asp-items="ViewBag.cboRoomType"></select>
                            </div>
                            <div class="form-group-new-reservation" style="margin-right:20px;">
                                <label for="roomSelect">Room</label>
                                <div class="action-button-new-reservation">
                                    <input id="roomSelect" readonly />
                                    <input id="roomID" style="display:none" />
                                    <button id="btnRoom" onclick="openModalSearchRoom()"><i class="fa-solid fa-ellipsis"></i></button>
                                </div>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtRN">RN</label>
                                <input id="txtRN" />
                            </div>
                            <div class="rate-row-new-reservation">
                                <div class="form-group-new-reservation">
                                    <label for="txtRateCode">Rate Code</label>
                                    <div class="action-button-new-reservation">
                                        <input id="txtRateCode" style="text-align:right" readonly />
                                        <input id="txtRateCodeID" style="display:none" readonly />
                                        <button onclick="openModalRateCode()"><i class="fa-solid fa-ellipsis"></i></button>
                                    </div>
                                </div>
                                <div class="form-group-new-reservation">
                                    <label for="txtRateAmount">Rate</label>
                                    <input value="0" id="txtRateAmount" style="text-align:right">
                                </div>
                                <div class="form-group-new-reservation">
                                    <label for="txtNetAmount">Net</label>
                                    <input value="0" id="txtNetAmount" style="text-align:right">
                                </div>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtPackage">Packages</label>
                                <select id="txtPackage" asp-items="ViewBag.cboPackage"></select>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtAllotment">Allotment</label>
                                <div class="action-button-new-reservation">
                                    <input id="txtAllotment" readonly />
                                    <input id="txtAllotmentID" readonly style="display:none" />
                                    <button onclick="openModalSearchAllotment()"><i class="fa-solid fa-ellipsis"></i></button>
                                </div>
                            </div>
                            <div class="form-group-new-reservation" style="margin-right:20px;">
                                <label for="txtDiscountAmount">Disc. Amt</label>
                                <input type="text" value="0" id="txtDiscountAmount" style="text-align:right">
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtDiscountPercent">Disc. %</label>
                                <input type="text" value="0" id="txtDiscountPercent" style="text-align:right">
                            </div>
                        </div>
                    </div>

                    <!-- Rate & Packages -->
                    <div class="section-new-reservation">
                        <h3>Rate Summary</h3>
                        <div class="form-grid-new-reservation">
                            <div class="form-group-new-reservation">
                                <label for="txtResType">Res. Type</label>
                                <select id="txtResType" asp-items="ViewBag.cboReservationType"></select>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtMarket">Market</label>
                                <div class="action-button-new-reservation">
                                    <input id="txtMarket" />
                                    <input id="txtMarketID" style="display:none" />
                                    <button onclick="openModalSearchMarket()"><i class="fa-solid fa-ellipsis"></i></button>
                                </div>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtSource">Source</label>
                                <select id="txtSource" asp-items="ViewBag.cboSource"></select>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtPersonInCharge">Sale</label>
                                <select id="txtPersonInCharge" asp-items="ViewBag.cboPersonInCharge"></select>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtPayment">Payment</label>
                                <select id="txtPayment" asp-items="ViewBag.cboPaymentMethod"></select>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtCRSNo">CRS No</label>
                                <input type="text" id="txtCRSNo">
                            </div>
                            <div class="form-group-new-reservation full-width-new-reservation">
                                <label for="txtBooker">Booker</label>
                                <div class="action-button-new-reservation">
                                    <input id="txtBooker" />
                                    <input id="txtBookerID" style="display:none" />
                                    <button onclick="openModalSearchBooker()"><i class="fa-solid fa-ellipsis"></i></button>
                                </div>
                            </div>
                            <div class="form-group-new-reservation" style="margin-right: 20px;">
                                <label for="txtETA">ETA</label>
                                <input type="time" value="06:00" id="txtETA" style="text-align:right">
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtETD">ETD</label>
                                <input type="time" value="12:00" id="txtETD" style="text-align:right">
                            </div>
                            <div class="form-group-new-reservation full-width-new-reservation">
                                <label for="txtRateAfterDiscount">Rate After Discount</label>
                                <div class="action-button-new-reservation">
                                    <input value="0" id="txtRateAfterDiscount" readonly style="text-align:right">
                                    <span style="font-size:12px">+ net</span>
                                    <input value="0" id="txtNetAfterDiscount" readonly style="text-align:right">
                                </div>
                                <span style="font-size:12px;color:#c53030">Rate amount after discount</span>
                            </div>
                            <div class="form-group-new-reservation full-width-new-reservation">
                                <label for="txtTotal">Total</label>
                                <div class="action-button-new-reservation">
                                    <input type="number" value="0" id="txtTotal" readonly style="text-align:right">
                                    <span style="font-size:12px">+ net</span>
                                    <input type="number" value="0" id="txtTotalNet" readonly style="text-align:right">
                                </div>
                            </div>
                            <div class="form-group-new-reservation full-width-new-reservation">
                                <label for="txtReason">Reason</label>
                                <select id="txtReason" asp-items="ViewBag.cboReason"></select>
                            </div>
                        </div>
                    </div>

                    <!-- Booking & Special Requests -->
                    <div class="section-new-reservation">
                        <h3>Booking & Special Requests</h3>
                        <div class="form-grid-new-reservation">
                            <div class="form-group-new-reservation">
                                <label for="txtPreference">Specials</label>
                                <div class="action-button-new-reservation">
                                    <input id="txtPreference" />
                                    <button onclick="openModalSearchPreference()"><i class="fa-solid fa-ellipsis"></i></button>
                                </div>
                            </div>
                            <div class="form-group-new-reservation">
                                <label for="txtPromotion">Promotions</label>
                                <select id="txtPromotion" asp-items="ViewBag.cboPromotion"></select>
                            </div>
                            <div class="form-group-new-reservation full-width-new-reservation">
                                <label for="txtItemInventory">Item Inventory</label>
                                <select id="txtItemInventory" disabled multiple asp-items="ViewBag.cboItem"></select>
                            </div>
                            <div class="currency-row-new-reservation">
                                <div class="form-group-new-reservation">
                                    <label for="txtColor">Set Color</label>
                                    <input type="color" id="txtColor">
                                </div>
                                <div class="form-group-new-reservation" style="margin-right: 20px;">
                                    <label for="txtFolioBal">Folio Balance</label>
                                    <input type="number" value="0" id="txtFolioBal" style="text-align:right">
                                </div>
                                <div class="form-group-new-reservation">
                                    <label for="txtCurrency">$</label>
                                    <input type="number" value="0" id="txtCurrency">
                                    <span style="font-size:12px;color:#c53030">VND</span>
                                </div>
                            </div>
                            <div class="checkbox-row-new-reservation">
                                <div class="form-group-new-reservation">
                                    <label for="txtPrintRate">Print Rate</label>
                                    <input type="checkbox" id="txtPrintRate">
                                </div>
                                <div class="form-group-new-reservation">
                                    <label for="txtVideoCheckout">Video CO</label>
                                    <input type="checkbox" id="txtVideoCheckout">
                                </div>
                                <div class="form-group-new-reservation">
                                    <label for="txtNoPost">No Post</label>
                                    <input type="checkbox" id="txtNoPost">
