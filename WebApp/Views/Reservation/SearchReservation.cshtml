<div class="header mt-2" style="border-bottom:none;justify-content:center">
    <h3 id="content-title">
        Search Reservation

    </h3>

</div>
<div class="mt-1">

    <div class="row">
        <!-- Menu trái -->
        <div class="col-md-3 mb-2">
            <div class="mui-card">
                <div class="header" style="justify-content:space-between">
                    <div class="header2">
