    $('#txtName').on('change', function() {
        var value = $(this).val();
        getInfoByProfileID(value);

        // Lấy instance của TomSelect cho #txtItemInventory
        var tomSelectInstance = $('#txtItemInventory')[0].tomselect; // Lấy đối tượng TomSelect

        if (value && value !== '0') {
            if (tomSelectInstance) {
                tomSelectInstance.enable(); // Sử dụng API của TomSelect để enable
            } else {
                // Fallback: Thử enable bằng jQuery nếu không tìm thấy TomSelect
                $('#txtItemInventory').prop('disabled', false);
            }
        } else {
            if (tomSelectInstance) {
                tomSelectInstance.disable(); // Sử dụng API của TomSelect để disable
            } else {
                $('#txtItemInventory').prop('disabled', true);
            }
        }
    });
    
