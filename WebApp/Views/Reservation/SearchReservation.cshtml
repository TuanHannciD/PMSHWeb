    function extractLastName(name) {
        const parts = name.trim().split(/,\s*/);
        return parts[1] || '';
    }

    function validateName(name) {
        // Regex for "FirstName MiddleName, LastName" or "FirstName MiddleName,LastName"
        const namePattern = /^[A-Z][a-z]*\s[A-Z][a-z]*,\s*[A-Z][a-z]*$/;
        return namePattern.test(name.trim());
    }
    $('#txtName').on('blur', function() {
        const name = $(this).val();
        if (name) {
            if (validateName(name)) {
                const lastName = extractLastName(name);
                $('#txtFirstName').val(lastName);
                $('#nameProfileSearch').val(name);
            } else {
                showToast('Error', 'Invalid name format! Use FirstName MiddleName LastName or FirstName MiddleName,LastName', false);
                $('#txtName').val('');
                $('#txtFirstName').val('');
            }
        } else {
            $('#txtItemInventory').prop('disabled', true); // Keep disabled if name is empty
        }
    });
