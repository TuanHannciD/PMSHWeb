<script>
        // Function menu click handler
    document.querySelectorAll('.function-menu a, .function-menu .dropdown-menu-custom a').forEach(item => {
      item.addEventListener('click', e => {
        e.preventDefault();
        const functionId = item.getAttribute('data-function');
        document.querySelectorAll('.function-menu a').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.function-content').forEach(el => el.classList.remove('active'));
        item.classList.add('active');
        if (document.getElementById(`function-${functionId}`)) {
          document.getElementById(`function-${functionId}`).classList.add('active');
        } else {
        }
      });
    });
    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const tabId = tab.getAttribute('data-tab');
        const isCollapsed = tab.classList.contains('collapsed');
        const icon = tab.querySelector('.tab-icon');

        if (isCollapsed) {
          document.querySelectorAll('.tab').forEach(el => {
            el.classList.remove('active');
            el.classList.add('collapsed');
            const elIcon = el.querySelector('.tab-icon');
            elIcon.classList.remove('fa-minus');
            elIcon.classList.add('fa-plus');
          });
          document.querySelectorAll('.tab-pane').forEach(el => {
            el.classList.remove('active');
            el.style.display = 'none';
          });

          tab.classList.remove('collapsed');
          tab.classList.add('active');
          icon.classList.remove('fa-plus');
          icon.classList.add('fa-minus');

          const target = document.getElementById(tabId);
          target.classList.add('active');
          target.style.display = 'block';
        } else {
          tab.classList.add('collapsed');
          tab.classList.remove('active');
          icon.classList.remove('fa-minus');
          icon.classList.add('fa-plus');

          const target = document.getElementById(tabId);
          target.classList.remove('active');
          target.style.display = 'none';
        }
      });
    });
    // Menu left collapse handler
    document.querySelector('.menu-left .toggle-btn').addEventListener('click', () => {
      const menuLeft = document.querySelector('.menu-left');
      menuLeft.classList.toggle('collapsed');
    });


