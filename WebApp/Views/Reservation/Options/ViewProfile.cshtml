<style>
    /* General Modal Styling */
    .modal-content {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        background-color: #f9fafb;
    }

    /* Modal Header */
    .modal-header {
        background-color: #ffffff;
        border-bottom: 1px solid #e5e7eb;
