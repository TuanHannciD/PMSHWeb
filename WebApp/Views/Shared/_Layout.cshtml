    <style>
        .navbar-custom {
            background-color: #3b9ac6;
            padding: 5px;
        }

            .navbar-custom .navbar-nav .nav-link {
                color: white;
                font-size: 14px;
                padding: 8px 14px;
                border-radius: 5px;
                transition: background-color 0.2s ease;
            }

                .navbar-custom .navbar-nav .nav-link:hover {
                    background-color: #005f87;
                    color: white;
                }

                .navbar-custom .navbar-nav .nav-link.active {
                    background-color: #3b9ac6;
                }

            /* Dropdown hiển thị khi hover */
            .navbar-custom .dropdown:hover > .dropdown-menu {
                display: block;
            }

            .navbar-custom .dropdown:hover > .nav-link {
                background-color: #005f87;
                color: white;
            }

            /* Menu con (dropdown-menu) */
            .navbar-custom .dropdown-menu {
                background-color: white;
                display: none;
                margin-top: 0;
                border: none;
                box-shadow: 0px 2px 6px rgba(0, 0, 0, 0.15);
                padding: 8px 0; /* tạo khoảng cách trên dưới */
                border-radius: 6px;
                min-width: 180px;
            }

            .navbar-custom .dropdown-item {
                color: #005f87;
                font-size: 14px;
                padding: 8px 16px;
                border-radius: 5px;
                transition: background-color 0.2s ease;
            }

                .navbar-custom .dropdown-item:hover {
                    background-color: #005f87; /* giống menu cha */
                    color: white;
                }

            .navbar-custom .dropdown-toggle::after {
                vertical-align: middle;
                margin-left: 5px;
            }
        /* Hiển thị menu cấp 2 khi hover */
        .dropdown-submenu {
            position: relative;
        }

            .dropdown-submenu > .dropdown-menu {
                top: 0;
                left: 100%;
                margin-top: -1px;
                display: none;
                position: absolute;
            }

            .dropdown-submenu:hover > .dropdown-menu {
                display: block;
            }

        .dropdown-menu {
            z-index: 1000;
        }

        .scrollable-dropdown {
            max-height: 400px; /* có thể điều chỉnh chiều cao tối đa tùy ý */
            overflow-y: auto;
            overflow-x: hidden;
        }

        .disabled-link {
            pointer-events: none;
            opacity: 0.4;
        }

        .img-fluid {
            width: 100vw;
        }



    </style>
