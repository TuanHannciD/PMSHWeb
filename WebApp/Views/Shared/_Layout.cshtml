<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/css/button.css" rel="stylesheet" />
    <link href="~/css/input.css" rel="stylesheet" />
    <link href="~/css/card.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />

    @* jquery *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script type="text/javascript" src="~/lib/jqueryui/jquery-ui.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/jquery-confirm/jquery-confirm.min.css"></script>
    <script type="text/javascript" src="~/lib/jquery-confirm/jquery-confirm.min.js"></script>

    <link href="~/lib/node_modules/devextreme/dist/css/dx.common.css" rel="stylesheet" />
    <link href="~/lib/node_modules/devextreme/dist/css/dx.light.css" rel="stylesheet" />
    <link href="~/lib/node_modules/@@devexpress/analytics-core/dist/css/dx-analytics.common.css" rel="stylesheet" />
    <link href="~/lib/node_modules/@@devexpress/analytics-core/dist/css/dx-analytics.light.css" rel="stylesheet" />
    <link href="~/lib/node_modules/devexpress-reporting/dist/css/dx-webdocumentviewer.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-confirm/3.3.4/jquery-confirm.min.js"></script>

    @* tomlect *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css" />
    <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>

    @* devextreme *@
@*     <script src="https://cdn3.devexpress.com/jslib/23.1.4/js/dx.all.js"></script> *@
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.1.4/css/dx.material.blue.light.css" />

    @* font-anesome *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script asp-append-version="true" src="~/lib/node_modules/jquery/dist/jquery.js"></script>
    <script asp-append-version="true" src="~/lib/node_modules/jquery-ui-dist/jquery-ui.js"></script>
    <script asp-append-version="true" src="~/lib/node_modules/knockout/build/output/knockout-latest.js"></script>
    <script src="~/lib/devextreme/dist/js/dx.all.js"></script>
    <script asp-append-version="true" src="~/lib/node_modules/@@devexpress/analytics-core/dist/js/dx-analytics-core.min.js"></script>
    <script asp-append-version="true" src="~/lib/node_modules/devexpress-reporting/dist/js/dx-webdocumentviewer.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/devextreme/22.2.4/js/pdfExporter.js"></script>
    <style>
        .navbar-custom {
            background-color: #3b9ac6;
            padding: 5px;
        }

            .navbar-custom .navbar-nav .nav-link {
                color: white;
                font-size: 14px;
                padding: 8px 14px;
                border-radius: 5px;
                transition: background-color 0.2s ease;
            }

                .navbar-custom .navbar-nav .nav-link:hover {
                    background-color: #005f87;
                    color: white;
                }

                .navbar-custom .navbar-nav .nav-link.active {
                    background-color: #3b9ac6;
                }

            /* Dropdown hiển thị khi hover */
            .navbar-custom .dropdown:hover > .dropdown-menu {
                display: block;
            }

            .navbar-custom .dropdown:hover > .nav-link {
                background-color: #005f87;
                color: white;
            }

            /* Menu con (dropdown-menu) */
            .navbar-custom .dropdown-menu {
                background-color: white;
                display: none;
                margin-top: 0;
                border: none;
                box-shadow: 0px 2px 6px rgba(0, 0, 0, 0.15);
                padding: 8px 0; /* tạo khoảng cách trên dưới */
                border-radius: 6px;
                min-width: 180px;
            }

            .navbar-custom .dropdown-item {
                color: #005f87;
                font-size: 14px;
                padding: 8px 16px;
                border-radius: 5px;
                transition: background-color 0.2s ease;
            }

                .navbar-custom .dropdown-item:hover {
                    background-color: #005f87; /* giống menu cha */
                    color: white;
                }

            .navbar-custom .dropdown-toggle::after {
                vertical-align: middle;
                margin-left: 5px;
            }
    </style>
</head>
<body>
    <header>
        <div class="banner">
            <img src="~/images/banner.PNG" alt="Banner Image" class="img-fluid">
        </div>
        <nav class="navbar navbar-expand-md navbar-custom">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#">Profile</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="SearchProfile">Search Profile</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index">New profile</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" >Report </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Report" asp-action="ReservationSummaryReport">Reservation Summary Report</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Report" asp-action="GroupReservationReport">Group Reservation Report</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Report" asp-action="GuestStayOverReport">Guest Stay Over Report</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Report" asp-action="GuestStayReport">Guest Stay Report</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Report" asp-action="TraceReport">Trace Report</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Report" asp-action="BookingSource">Booking Source</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Report" asp-action="ReportNationalityStatistics">Report Nationality Statistics</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Report" asp-action="RatecodebyDateReport">Ratecode by Date Report</a></li>

                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#">Reservation</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Reservation" asp-action="NewReservation">New Reservation</a></li>
                            </ul>
                        </li>
                    </ul>


                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="User" asp-action="Index">[ admin - THOÁT ]</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div>
        <main role="main"  style="background-color:#fafafa">
            @RenderBody()
        </main>
    </div>

@*     <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - WebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
